# En-tetes Cloudflare (Workers Static Assets) - crm-logiciel.fr

# Securite : applique a toutes les reponses (neutre pour le SEO).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Assets hashes par Astro (le nom change a chaque modification du contenu) :
# cache immuable 1 an, plus aucune revalidation reseau sur les visites repetees.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Polices auto-hebergees : stables, cache long immuable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Forcer le charset UTF-8 sur les fichiers texte servis en text/plain (accents FR),
# sinon certains navigateurs les rendent en Latin-1 (mojibake).
/robots.txt
  Content-Type: text/plain; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8

# Forcer le bon type MIME du sitemap. Le site est 100 % statique : le
# Content-Type defini dans src/pages/sitemap.xml.ts est perdu au build (Astro
# prerend un simple fichier dist/sitemap.xml) et Cloudflare Static Assets ne le
# sert PAS en application/xml par defaut. Avec X-Content-Type-Options: nosniff
# (applique a /*), le navigateur ne corrige pas : le sitemap s'affiche en texte
# brut et la Search Console renvoie « impossible de lire le sitemap ».
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# Le HTML reste en revalidation immediate (must-revalidate) pour que toute mise a
# jour de contenu soit prise en compte aussitot.
