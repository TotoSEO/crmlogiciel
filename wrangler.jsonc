{
  // Déploiement Cloudflare 100 % statique (Workers Static Assets).
  // Aucun `main` (pas de Worker SSR), aucun binding (pas de provisioning KV/Images) :
  // Cloudflare sert directement le dossier `dist/` généré par `astro build`.
  "name": "crmlogiciel",
  "compatibility_date": "2026-06-13",
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
