---
/**
 * BaseLayout — squelette global de toutes les pages.
 * Compose <head> (via Head + slot « head » pour le JSON-LD), la navigation,
 * le contenu (slot par défaut) et le footer. Le contenu essentiel est rendu
 * dans le HTML source, sans dépendance au JavaScript.
 */
import '../styles/global.css';
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  canonicalSlug: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  noindex?: boolean;
  rawTitle?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  /** Affiche l'en-tête et le pied de page (défaut : oui). */
  chrome?: boolean;
}

const {
  title,
  description,
  canonicalSlug,
  ogType,
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  noindex,
  rawTitle,
  publishedTime,
  modifiedTime,
  chrome = true,
} = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Head
      title={title}
      description={description}
      canonicalSlug={canonicalSlug}
      ogType={ogType}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      noindex={noindex}
      rawTitle={rawTitle}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    {/* Emplacement du JSON-LD (injecté dans la source par chaque page). */}
    <slot name="head" />
  </head>

  <body>
    {/* Fond ambiant global (halos colorés flous, plein écran, derrière tout). */}
    <div class="site-ambient" aria-hidden="true">
      <span class="site-ambient__blob site-ambient__blob--1"></span>
      <span class="site-ambient__blob site-ambient__blob--2"></span>
      <span class="site-ambient__blob site-ambient__blob--3"></span>
    </div>

    <a href="#contenu" class="skip-link">Aller au contenu</a>
    {chrome && <Nav />}
    <main id="contenu">
      <slot />
    </main>
    {chrome && <Footer />}
  </body>
</html>
