---
/**
 * CalculateurRoi — estime le ROI d'un CRM à partir des chiffres du visiteur.
 * Deux modes (simple / avancé), calcul en TEMPS RÉEL, saisie à gauche et
 * résultats à droite (empilés en mobile, avec un rappel du résultat clé qui
 * suit le défilement). Aucune collecte de donnée, aucun mur.
 *
 * Rendu côté serveur : les champs (préremplis) et un exemple de résultat sont
 * dans la source. Sans JS, les champs et la méthode restent lisibles ; le calcul
 * interactif nécessite JavaScript (note affichée).
 */
import { SIMPLE, ADVANCED, compute, defaults, fmtEur, fmtRoi, fmtDelai } from '../data/calculateur-roi';

const d = compute('simple', defaults(SIMPLE));
const suffix = { eur: '€', pct: '%', h: 'h', num: '' } as const;
---

<section class="roi not-prose" aria-label="Calculateur de ROI d'un CRM">
  <div class="roi-switch" role="group" aria-label="Mode de calcul">
    <button type="button" class="roi-switch__btn is-active" data-mode-btn="simple" aria-pressed="true">
      Simple
    </button>
    <button type="button" class="roi-switch__btn" data-mode-btn="avance" aria-pressed="false">
      Avancé
    </button>
  </div>

  <div class="roi-grid">
    {/* ------- Saisie ------- */}
    <div class="roi-form">
      <div class="roi-fields" data-mode="simple">
        {
          SIMPLE.map((f) => (
            <label class="roi-field">
              <span class="roi-field__label">{f.label}</span>
              <span class="roi-field__wrap" data-suffix={suffix[f.unit]}>
                <input
                  class="roi-input"
                  id={`roi-simple-${f.key}`}
                  data-key={f.key}
                  data-def={f.def}
                  type="number"
                  value={f.def}
                  min={f.min}
                  step={f.step}
                  inputmode="decimal"
                />
              </span>
              {f.hint && <span class="roi-field__hint">{f.hint}</span>}
            </label>
          ))
        }
      </div>

      <div class="roi-fields" data-mode="avance" hidden>
        {
          ADVANCED.map((f) => (
            <label class="roi-field">
              <span class="roi-field__label">{f.label}</span>
              <span class="roi-field__wrap" data-suffix={suffix[f.unit]}>
                <input
                  class="roi-input"
                  id={`roi-avance-${f.key}`}
                  data-key={f.key}
                  data-def={f.def}
                  type="number"
                  value={f.def}
                  min={f.min}
                  step={f.step}
                  inputmode="decimal"
                />
              </span>
              {f.hint && <span class="roi-field__hint">{f.hint}</span>}
            </label>
          ))
        }
      </div>

      <div class="roi-form__foot">
        <button type="button" class="roi-reset">↻ Réinitialiser</button>
        <p class="roi-note">
          Hypothèses prudentes et modifiables. Aucune donnée n'est collectée. Résultat = estimation,
          pas une garantie. <br />ROI = chiffre d'affaires additionnel ÷ coût annuel du CRM.
        </p>
      </div>
    </div>

    {/* ------- Résultats ------- */}
    <div class="roi-out">
      <p class="roi-out__kicker is-data">Votre estimation</p>
      <div class="roi-hero">
        <p class="roi-hero__val is-data" id="roi-ca">{fmtEur(d.ca)}</p>
        <p class="roi-hero__label">de chiffre d'affaires additionnel estimé par an</p>
      </div>

      <div class="roi-levers" hidden>
        <p class="roi-levers__title">Détail par levier</p>
        <ul class="roi-levers__list">
          <li>
            Ventes récupérées <span class="is-data" id="roi-recuperees">—</span>
          </li>
          <li>
            Meilleure conversion <span class="is-data" id="roi-conversion">—</span>
          </li>
          <li>
            Temps gagné <span class="is-data" id="roi-temps">—</span>
          </li>
        </ul>
      </div>

      <dl class="roi-metrics">
        <div class="roi-metric">
          <dt>Coût annuel du CRM</dt>
          <dd class="is-data" id="roi-cout">{fmtEur(d.cout)}</dd>
        </div>
        <div class="roi-metric">
          <dt>Gain net annuel</dt>
          <dd class="is-data" id="roi-net">{fmtEur(d.net)}</dd>
        </div>
        <div class="roi-metric">
          <dt>Retour sur investissement</dt>
          <dd class="is-data" id="roi-roi">{fmtRoi(d.roi)}</dd>
        </div>
        <div class="roi-metric">
          <dt>Délai de rentabilité</dt>
          <dd class="is-data" id="roi-delai">{fmtDelai(d.delai)}</dd>
        </div>
      </dl>

      <p class="roi-table">
        Ce que vous laissez sur la table chaque année :
        <b class="is-data" id="roi-table">{fmtEur(d.ca)}</b>
      </p>

      <div class="roi-out__cta">
        <a href="/crm-gratuit/" class="roi-cta roi-cta--primary">Tester un CRM gratuit</a>
        <a href="/comment-choisir-crm/" class="roi-cta roi-cta--ghost">Choisir le bon outil</a>
      </div>
    </div>
  </div>

  <div class="roi-recall" aria-hidden="true">
    <span class="roi-recall__label">CA additionnel / an</span>
    <span class="roi-recall__val is-data" id="roi-recall">{fmtEur(d.ca)}</span>
  </div>

  <noscript>
    <p class="roi-noscript">
      Le calcul en temps réel nécessite JavaScript. Les champs ci-dessus et la méthode plus bas
      restent consultables. Formule : <em>ROI = chiffre d'affaires additionnel ÷ coût annuel du CRM</em>.
    </p>
  </noscript>
</section>

<script>
  import { compute, fmtEur, fmtRoi, fmtDelai } from '../data/calculateur-roi';

  const rootEl = document.querySelector<HTMLElement>('.roi');
  if (rootEl) {
    const root: HTMLElement = rootEl;
    let mode: 'simple' | 'avance' = 'simple';
    const panel = (m: string) => root.querySelector<HTMLElement>(`.roi-fields[data-mode="${m}"]`)!;
    const set = (id: string, val: string) => {
      const el = root.querySelector<HTMLElement>('#' + id);
      if (el) el.textContent = val;
    };

    function readValues(): Record<string, number> {
      const out: Record<string, number> = {};
      panel(mode)
        .querySelectorAll<HTMLInputElement>('.roi-input')
        .forEach((inp) => {
          out[inp.dataset.key!] = parseFloat(inp.value);
        });
      return out;
    }

    function render() {
      const r = compute(mode, readValues());
      set('roi-ca', fmtEur(r.ca));
      set('roi-recall', fmtEur(r.ca));
      set('roi-table', fmtEur(r.ca));
      set('roi-cout', fmtEur(r.cout));
      set('roi-net', fmtEur(r.net));
      set('roi-roi', fmtRoi(r.roi));
      set('roi-delai', fmtDelai(r.delai));
      const levers = root.querySelector<HTMLElement>('.roi-levers')!;
      levers.hidden = mode !== 'avance';
      if (mode === 'avance') {
        set('roi-recuperees', fmtEur(r.recuperees ?? 0));
        set('roi-conversion', fmtEur(r.conversion ?? 0));
        set('roi-temps', fmtEur(r.temps ?? 0));
      }
      root.querySelector<HTMLElement>('#roi-net')?.classList.toggle('is-neg', r.net < 0);
    }

    function setMode(m: 'simple' | 'avance') {
      mode = m;
      panel('simple').hidden = m !== 'simple';
      panel('avance').hidden = m !== 'avance';
      root.querySelectorAll<HTMLButtonElement>('.roi-switch__btn').forEach((b) => {
        const on = b.dataset.modeBtn === m;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      render();
    }

    function reset() {
      panel(mode)
        .querySelectorAll<HTMLInputElement>('.roi-input')
        .forEach((inp) => {
          inp.value = inp.dataset.def ?? '';
        });
      render();
    }

    root.addEventListener('input', (e) => {
      if ((e.target as HTMLElement).closest('.roi-input')) render();
    });
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const mb = t.closest<HTMLElement>('[data-mode-btn]');
      if (mb) setMode(mb.dataset.modeBtn as 'simple' | 'avance');
      else if (t.closest('.roi-reset')) reset();
    });

    root.classList.add('roi--js');
    render();
  }
</script>

<style>
  .roi {
    position: relative;
    padding: clamp(var(--space-4), 3.5vw, var(--space-8));
    border-radius: var(--radius-2xl);
    border: var(--rule-hair) solid var(--border-default);
    background:
      radial-gradient(90% 55% at 50% 0%, var(--blue-tint), transparent 65%), var(--surface-card);
    box-shadow: var(--shadow-soft);
  }

  /* ---- Interrupteur Simple / Avancé ---- */
  .roi-switch {
    display: inline-flex;
    gap: 2px;
    padding: 4px;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-full);
    background: var(--surface-sunk);
    border: var(--rule-hair) solid var(--border-default);
  }
  .roi-switch__btn {
    min-height: 2.4rem;
    padding: var(--space-2) var(--space-5);
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    font-family: var(--font-ui);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-sm);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      background 0.18s ease,
      color 0.18s ease,
      box-shadow 0.18s ease;
  }
  .roi-switch__btn.is-active {
    background: var(--surface-card);
    color: var(--blue-ink);
    box-shadow: var(--shadow-soft);
  }

  /* ---- Grille saisie / résultats ---- */
  .roi-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }
  .roi-fields {
    display: grid;
    gap: var(--space-4);
  }
  .roi-field {
    display: grid;
    gap: var(--space-2);
  }
  .roi-field__label {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--ink-80);
  }
  .roi-field__wrap {
    position: relative;
  }
  .roi-field__wrap[data-suffix]:not([data-suffix=''])::after {
    content: attr(data-suffix);
    position: absolute;
    top: 50%;
    right: var(--space-4);
    transform: translateY(-50%);
    font-family: var(--font-data);
    font-size: var(--text-sm);
    color: var(--text-muted);
    pointer-events: none;
  }
  .roi-input {
    width: 100%;
    min-height: var(--tap-min);
    padding: var(--space-3) var(--space-8) var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: var(--rule-medium) solid var(--border-strong);
    background: var(--surface-card);
    font-family: var(--font-data);
    font-feature-settings: var(--num-tabular);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--ink);
  }
  .roi-input:focus-visible {
    outline: none;
    border-color: var(--blue);
    box-shadow: var(--shadow-glow);
  }
  .roi-field__hint {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .roi-form__foot {
    margin-top: var(--space-5);
  }
  .roi-reset {
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-full);
    border: var(--rule-hair) solid var(--border-strong);
    background: var(--surface-card);
    font-family: var(--font-ui);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-sm);
    color: var(--ink-80);
    cursor: pointer;
  }
  .roi-reset:hover {
    background: var(--surface-sunk);
  }
  .roi-note {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ---- Panneau résultats ---- */
  .roi-out {
    position: sticky;
    top: 5rem;
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    border: var(--rule-hair) solid var(--border-default);
    background: color-mix(in srgb, var(--blue-tint) 40%, var(--surface-card));
  }
  .roi-out__kicker {
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--blue);
  }
  .roi-hero {
    margin-top: var(--space-2);
    padding-bottom: var(--space-5);
    border-bottom: var(--rule-hair) solid var(--border-default);
  }
  .roi-hero__val {
    font-family: var(--font-data);
    font-feature-settings: var(--num-tabular);
    font-weight: var(--font-weight-bold);
    font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
    line-height: 1;
    color: var(--blue-ink);
  }
  .roi-hero__label {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .roi-levers {
    margin-top: var(--space-4);
  }
  .roi-levers__title {
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .roi-levers__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .roi-levers__list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-body);
  }
  .roi-levers__list .is-data {
    font-family: var(--font-data);
    font-weight: var(--font-weight-semibold);
    color: var(--ink);
  }
  .roi-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
  }
  .roi-metric {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    border: var(--rule-hair) solid var(--border-default);
  }
  .roi-metric dt {
    font-size: var(--text-2xs);
    color: var(--text-muted);
  }
  .roi-metric dd {
    margin: 2px 0 0;
    font-family: var(--font-data);
    font-feature-settings: var(--num-tabular);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-xl);
    color: var(--ink);
  }
  .roi-metric dd.is-neg {
    color: var(--minium-ink, var(--text-muted));
  }
  .roi-table {
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--orange-tint);
    color: var(--orange-ink);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .roi-table b {
    font-family: var(--font-data);
    font-weight: var(--font-weight-bold);
  }
  .roi-out__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .roi-cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-full);
    font-family: var(--font-ui);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-sm);
  }
  .roi-cta--primary {
    background: var(--blue);
    color: #fff;
    box-shadow: var(--shadow-glow);
  }
  .roi-cta--primary:hover {
    background: var(--blue-ink);
    text-decoration: none;
  }
  .roi-cta--ghost {
    border: var(--rule-medium) solid var(--border-strong);
    color: var(--blue-ink);
  }
  .roi-cta--ghost:hover {
    background: var(--blue-tint);
    text-decoration: none;
  }

  /* ---- Rappel mobile (résultat clé sticky) ---- */
  .roi-recall {
    display: none;
  }
  .roi-noscript {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .roi-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .roi-out {
      position: static;
    }
    .roi--js .roi-recall {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-4);
      position: sticky;
      bottom: var(--space-3);
      margin-top: var(--space-4);
      padding: var(--space-3) var(--space-5);
      border-radius: var(--radius-full);
      background: var(--blue-ink);
      color: #fff;
      box-shadow: var(--shadow-raise);
    }
    .roi-recall__label {
      font-family: var(--font-ui);
      font-size: var(--text-xs);
      opacity: 0.85;
    }
    .roi-recall__val {
      font-family: var(--font-data);
      font-weight: var(--font-weight-bold);
      font-size: var(--text-lg);
    }
  }
</style>
