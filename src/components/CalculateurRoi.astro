---
/**
 * CalculateurRoi — met en balance ce qu'un CRM vous fait GAGNER (ventes
 * récupérées, meilleure conversion, temps gagné) et ce qu'il vous COÛTE
 * (abonnement + temps passé à l'alimenter + mise en place). Résultat clé :
 * le gain NET annuel et le délai d'amortissement.
 *
 * Deux modes (simple / avancé), calcul en TEMPS RÉEL, saisie à gauche et
 * résultats à droite (empilés en mobile, avec un rappel du résultat clé qui
 * suit le défilement). Base de facturation au choix (par utilisateur ou
 * forfait). En mode avancé, les champs peuvent rester vides (comptés à 0).
 * Aucune collecte de donnée, aucun mur.
 */
import { SIMPLE, ADVANCED, BILLING_OPTIONS, compute, defaults, fmtEur, fmtRoi, fmtDelai } from '../data/calculateur-roi';
import type { Field } from '../data/calculateur-roi';

const d = compute('simple', defaults(SIMPLE));
const suffix = { eur: '€', pct: '%', h: 'h', num: '' } as const;
---

<section class="roi not-prose" aria-label="Calculateur de ROI d'un CRM">
  <div class="roi-switch" role="group" aria-label="Mode de calcul">
    <button type="button" class="roi-switch__btn is-active" data-mode-btn="simple" aria-pressed="true">
      Simple
    </button>
    <button type="button" class="roi-switch__btn" data-mode-btn="avance" aria-pressed="false">
      Avancé
    </button>
  </div>

  <div class="roi-grid">
    {/* ------- Saisie ------- */}
    <div class="roi-form">
      {
        (['simple', 'avance'] as const).map((m) => (
          <div class="roi-fields" data-mode={m} hidden={m !== 'simple'}>
            {(m === 'simple' ? SIMPLE : ADVANCED).map((f: Field) => (
              <div class="roi-field">
                <div class="roi-field__head">
                  <label class="roi-field__label" for={`roi-${m}-${f.key}`}>
                    {f.label}
                  </label>
                  {f.optional && <span class="roi-field__opt">facultatif</span>}
                  {f.help && (
                    <span class="roi-help" tabindex="0" role="note" aria-label={`Aide : ${f.help}`}>
                      ?<span class="roi-tip" role="tooltip">{f.help}</span>
                    </span>
                  )}
                </div>

                {f.key === 'budget' ? (
                  <div class="roi-field__wrap roi-field__wrap--budget">
                    <span class="roi-money" data-suffix="€">
                      <input
                        class="roi-input"
                        id={`roi-${m}-${f.key}`}
                        data-key={f.key}
                        data-def={f.def}
                        type="number"
                        value={f.def}
                        min={f.min}
                        step={f.step}
                        inputmode="decimal"
                      />
                    </span>
                    <select class="roi-billing" id={`roi-${m}-billing`} aria-label="Base de facturation du CRM">
                      {BILLING_OPTIONS.map((o) => (
                        <option value={o.value} selected={o.value === 'user-month'}>
                          {o.label}
                        </option>
                      ))}
                    </select>
                  </div>
                ) : (
                  <span class="roi-field__wrap" data-suffix={suffix[f.unit]}>
                    <input
                      class="roi-input"
                      id={`roi-${m}-${f.key}`}
                      data-key={f.key}
                      data-def={f.def}
                      type="number"
                      value={f.def}
                      placeholder={f.optional ? String(f.def) : undefined}
                      min={f.min}
                      step={f.step}
                      inputmode="decimal"
                    />
                  </span>
                )}

                {f.hint && <span class="roi-field__hint">{f.hint}</span>}
              </div>
            ))}
          </div>
        ))
      }

      <div class="roi-form__foot">
        <button type="button" class="roi-reset">↻ Réinitialiser</button>
        <p class="roi-note">
          Hypothèses prudentes et modifiables. En mode avancé, un champ laissé vide compte pour
          zéro. Aucune donnée n'est collectée, le résultat est une estimation.
          <br />Gain net = valeur créée − coût total (abonnement + temps + mise en place).
        </p>
      </div>
    </div>

    {/* ------- Résultats ------- */}
    <div class="roi-out">
      <p class="roi-out__kicker is-data">Votre estimation</p>
      <div class="roi-hero">
        <p class="roi-hero__val is-data" id="roi-net">{fmtEur(d.net)}</p>
        <p class="roi-hero__label">
          de gain net estimé la première année
          <span class="roi-hero__sub">valeur créée par le CRM, une fois son coût déduit</span>
        </p>
      </div>

      <p class="roi-payback" id="roi-payback">
        <span class="roi-payback__icon" aria-hidden="true">⏱</span>
        <span>CRM amorti en <b class="is-data" id="roi-delai">{fmtDelai(d.delai)}</b></span>
      </p>

      <div class="roi-break">
        <div class="roi-break__col roi-break__col--gain">
          <p class="roi-break__title">Ce que le CRM vous fait gagner</p>
          <ul class="roi-break__list">
            <li class="roi-adv-only"><span>Ventes récupérées</span><span class="is-data" id="roi-recuperees">—</span></li>
            <li class="roi-adv-only"><span>Meilleure conversion</span><span class="is-data" id="roi-conversion">—</span></li>
            <li class="roi-adv-only"><span>Temps gagné</span><span class="is-data" id="roi-temps">—</span></li>
            <li class="roi-break__total"><span>Valeur créée / an</span><span class="is-data" id="roi-valeur">{fmtEur(d.valeur)}</span></li>
          </ul>
        </div>
        <div class="roi-break__col roi-break__col--cost">
          <p class="roi-break__title">Ce que le CRM vous coûte</p>
          <ul class="roi-break__list">
            <li class="roi-adv-only"><span>Abonnement</span><span class="is-data" id="roi-cout-abo">{fmtEur(d.coutAbo)}</span></li>
            <li class="roi-adv-only"><span>Temps passé à l'alimenter</span><span class="is-data" id="roi-cout-temps">—</span></li>
            <li class="roi-adv-only"><span>Mise en place</span><span class="is-data" id="roi-cout-setup">—</span></li>
            <li class="roi-break__total"><span>Coût total / an</span><span class="is-data" id="roi-cout">{fmtEur(d.cout)}</span></li>
          </ul>
        </div>
      </div>

      <p class="roi-ratio">
        Retour sur investissement estimé :
        <b class="is-data" id="roi-roi">{fmtRoi(d.roi)}</b>
        <span class="roi-ratio__hint" id="roi-roi-hint">chaque euro investi en rapporte {d.roi ? fmtRoi(d.roi) : '—'}</span>
      </p>

      <div class="roi-out__cta">
        <a href="/crm-gratuit/" class="roi-cta roi-cta--primary">Tester un CRM gratuit</a>
        <a href="/comment-choisir-crm/" class="roi-cta roi-cta--ghost">Choisir le bon outil</a>
      </div>
    </div>
  </div>

  <div class="roi-recall" aria-hidden="true">
    <span class="roi-recall__label">Gain net / an</span>
    <span class="roi-recall__val is-data" id="roi-recall">{fmtEur(d.net)}</span>
  </div>

  <noscript>
    <p class="roi-noscript">
      Le calcul en temps réel nécessite JavaScript. Les champs ci-dessus et la méthode plus bas
      restent consultables. Principe : <em>gain net = valeur créée par le CRM − son coût total
      (abonnement, temps passé à l'alimenter, mise en place)</em>.
    </p>
  </noscript>
</section>

<script>
  import { compute, fmtEur, fmtRoi, fmtDelai } from '../data/calculateur-roi';
  import type { Billing } from '../data/calculateur-roi';

  const rootEl = document.querySelector<HTMLElement>('.roi');
  if (rootEl) {
    const root: HTMLElement = rootEl;
    let mode: 'simple' | 'avance' = 'simple';
    const panel = (m: string) => root.querySelector<HTMLElement>(`.roi-fields[data-mode="${m}"]`)!;
    const set = (id: string, val: string) => {
      const el = root.querySelector<HTMLElement>('#' + id);
      if (el) el.textContent = val;
    };

    function readValues(): Record<string, number> {
      const out: Record<string, number> = {};
      panel(mode)
        .querySelectorAll<HTMLInputElement>('.roi-input')
        .forEach((inp) => {
          out[inp.dataset.key!] = inp.value === '' ? NaN : parseFloat(inp.value);
        });
      return out;
    }

    function readBilling(): Billing {
      const sel = panel(mode).querySelector<HTMLSelectElement>('.roi-billing');
      return (sel?.value as Billing) ?? 'user-month';
    }

    function render() {
      const r = compute(mode, readValues(), readBilling());

      // Résultat clé + rappel mobile.
      set('roi-net', fmtEur(r.net));
      set('roi-recall', fmtEur(r.net));
      root.querySelector<HTMLElement>('#roi-net')?.classList.toggle('is-neg', r.net < 0);

      // Amortissement / avertissement selon la rentabilité.
      const payback = root.querySelector<HTMLElement>('#roi-payback');
      if (payback) {
        payback.classList.toggle('is-neg', r.net < 0);
        if (r.net >= 0 && r.delai != null) {
          payback.innerHTML = `<span class="roi-payback__icon" aria-hidden="true">⏱</span><span>CRM amorti en <b class="is-data">${fmtDelai(r.delai)}</b></span>`;
        } else {
          payback.innerHTML = `<span class="roi-payback__icon" aria-hidden="true">⚠️</span><span>Pas rentable avec ces hypothèses — ajustez les chiffres</span>`;
        }
      }

      // Détail gains / coûts.
      set('roi-valeur', fmtEur(r.valeur));
      set('roi-cout', fmtEur(r.cout));
      set('roi-cout-abo', fmtEur(r.coutAbo));
      if (mode === 'avance') {
        set('roi-recuperees', fmtEur(r.recuperees ?? 0));
        set('roi-conversion', fmtEur(r.conversion ?? 0));
        set('roi-temps', fmtEur(r.temps ?? 0));
        set('roi-cout-temps', fmtEur(r.coutTemps ?? 0));
        set('roi-cout-setup', fmtEur(r.coutSetup ?? 0));
      }

      // Ratio ROI.
      set('roi-roi', fmtRoi(r.roi));
      set('roi-roi-hint', r.roi ? `chaque euro investi en rapporte ${fmtRoi(r.roi)}` : 'renseignez un coût');
    }

    function setMode(m: 'simple' | 'avance') {
      mode = m;
      panel('simple').hidden = m !== 'simple';
      panel('avance').hidden = m !== 'avance';
      root.classList.toggle('roi--advanced', m === 'avance');
      root.querySelectorAll<HTMLButtonElement>('.roi-switch__btn').forEach((b) => {
        const on = b.dataset.modeBtn === m;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      render();
    }

    function reset() {
      const p = panel(mode);
      p.querySelectorAll<HTMLInputElement>('.roi-input').forEach((inp) => {
        inp.value = inp.dataset.def ?? '';
      });
      const sel = p.querySelector<HTMLSelectElement>('.roi-billing');
      if (sel) sel.value = 'user-month';
      render();
    }

    root.addEventListener('input', (e) => {
      if ((e.target as HTMLElement).closest('.roi-input')) render();
    });
    root.addEventListener('change', (e) => {
      if ((e.target as HTMLElement).closest('.roi-billing')) render();
    });
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const mb = t.closest<HTMLElement>('[data-mode-btn]');
      if (mb) setMode(mb.dataset.modeBtn as 'simple' | 'avance');
      else if (t.closest('.roi-reset')) reset();
    });

    root.classList.add('roi--js');
    render();
  }
</script>

<style>
  .roi {
    position: relative;
    padding: clamp(var(--space-4), 3.5vw, var(--space-8));
    border-radius: var(--radius-2xl);
    border: var(--rule-hair) solid var(--border-default);
    background:
      radial-gradient(90% 55% at 50% 0%, var(--blue-tint), transparent 65%), var(--surface-card);
    box-shadow: var(--shadow-soft);
  }

  /* ---- Interrupteur Simple / Avancé ---- */
  .roi-switch {
    display: inline-flex;
    gap: 2px;
    padding: 4px;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-full);
    background: var(--surface-sunk);
    border: var(--rule-hair) solid var(--border-default);
  }
  .roi-switch__btn {
    min-height: 2.4rem;
    padding: var(--space-2) var(--space-5);
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    font-family: var(--font-ui);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-sm);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      background 0.18s ease,
      color 0.18s ease,
      box-shadow 0.18s ease;
  }
  .roi-switch__btn.is-active {
    background: var(--surface-card);
    color: var(--blue-ink);
    box-shadow: var(--shadow-soft);
  }

  /* ---- Grille saisie / résultats ---- */
  .roi-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }
  .roi-fields {
    display: grid;
    gap: var(--space-4);
  }
  .roi-field {
    display: grid;
    gap: var(--space-2);
  }
  .roi-field__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .roi-field__label {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--ink-80);
  }
  .roi-field__opt {
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    background: var(--surface-sunk);
  }
  /* ---- Bulle d'aide « ? » ---- */
  .roi-help {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    border-radius: var(--radius-full);
    background: var(--blue-tint);
    color: var(--blue-ink);
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    cursor: help;
  }
  .roi-tip {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 5;
    width: max-content;
    max-width: min(240px, 72vw);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--ink);
    color: #fff;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-regular);
    line-height: 1.45;
    letter-spacing: 0;
    text-transform: none;
    box-shadow: var(--shadow-raise);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.16s ease,
      transform 0.16s ease,
      visibility 0.16s;
  }
  .roi-help:hover .roi-tip,
  .roi-help:focus .roi-tip,
  .roi-help:focus-visible .roi-tip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .roi-field__wrap {
    position: relative;
  }
  .roi-field__wrap[data-suffix]:not([data-suffix=''])::after,
  .roi-money[data-suffix]:not([data-suffix=''])::after {
    content: attr(data-suffix);
    position: absolute;
    top: 50%;
    right: var(--space-4);
    transform: translateY(-50%);
    font-family: var(--font-data);
    font-size: var(--text-sm);
    color: var(--text-muted);
    pointer-events: none;
  }
  /* Champ budget : montant + base de facturation côte à côte */
  .roi-field__wrap--budget {
    display: flex;
    gap: var(--space-2);
    align-items: stretch;
  }
  .roi-money {
    position: relative;
    flex: 0 0 8.5rem;
  }
  .roi-input {
    width: 100%;
    min-height: var(--tap-min);
    padding: var(--space-3) var(--space-8) var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: var(--rule-medium) solid var(--border-strong);
    background: var(--surface-card);
    font-family: var(--font-data);
    font-feature-settings: var(--num-tabular);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--ink);
  }
  .roi-input:focus-visible,
  .roi-billing:focus-visible {
    outline: none;
    border-color: var(--blue);
    box-shadow: var(--shadow-glow);
  }
  .roi-billing {
    flex: 1;
    min-width: 0;
    min-height: var(--tap-min);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    border: var(--rule-medium) solid var(--border-strong);
    background: var(--surface-card);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--ink-80);
    cursor: pointer;
  }
  .roi-field__hint {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .roi-form__foot {
    margin-top: var(--space-5);
  }
  .roi-reset {
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-full);
    border: var(--rule-hair) solid var(--border-strong);
    background: var(--surface-card);
    font-family: var(--font-ui);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-sm);
    color: var(--ink-80);
    cursor: pointer;
  }
  .roi-reset:hover {
    background: var(--surface-sunk);
  }
  .roi-note {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ---- Panneau résultats ---- */
  .roi-out {
    position: sticky;
    top: 5rem;
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    border: var(--rule-hair) solid var(--border-default);
    background: color-mix(in srgb, var(--blue-tint) 40%, var(--surface-card));
  }
  .roi-out__kicker {
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--blue);
  }
  .roi-hero {
    margin-top: var(--space-2);
  }
  .roi-hero__val {
    font-family: var(--font-data);
    font-feature-settings: var(--num-tabular);
    font-weight: var(--font-weight-bold);
    font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
    line-height: 1;
    color: var(--blue-ink);
  }
  .roi-hero__val.is-neg {
    color: var(--minium, #c0362c);
  }
  .roi-hero__label {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--ink-80);
  }
  .roi-hero__sub {
    display: block;
    margin-top: 2px;
    font-weight: var(--font-weight-regular);
    color: var(--text-muted);
  }
  /* ---- Amortissement ---- */
  .roi-payback {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--green-tint);
    color: var(--green-ink);
    font-size: var(--text-sm);
    line-height: 1.3;
  }
  .roi-payback b {
    font-family: var(--font-data);
    font-weight: var(--font-weight-bold);
  }
  .roi-payback.is-neg {
    background: var(--orange-tint);
    color: var(--orange-ink);
  }
  .roi-payback__icon {
    font-size: var(--text-base);
  }

  /* ---- Détail gains / coûts ---- */
  .roi-break {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .roi-break__col {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    border: var(--rule-hair) solid var(--border-default);
  }
  .roi-break__col--gain {
    border-top: var(--rule-strong) solid var(--green);
  }
  .roi-break__col--cost {
    border-top: var(--rule-strong) solid var(--orange);
  }
  .roi-break__title {
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }
  .roi-break__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .roi-break__list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-body);
  }
  .roi-break__list .is-data {
    font-family: var(--font-data);
    font-weight: var(--font-weight-semibold);
    color: var(--ink);
    white-space: nowrap;
  }
  .roi-break__total {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: var(--rule-hair) solid var(--border-default);
    font-weight: var(--font-weight-semibold);
  }
  .roi-break__total .is-data {
    font-weight: var(--font-weight-bold);
  }
  /* Les lignes de détail par levier n'apparaissent qu'en mode avancé. */
  .roi-adv-only {
    display: none;
  }
  .roi--advanced .roi-adv-only {
    display: flex;
  }

  /* ---- Ratio ROI ---- */
  .roi-ratio {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
