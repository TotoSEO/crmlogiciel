---
/**
 * ReadingProgress — barre de progression de lecture (roadmap §4).
 * Fine bande sticky juste sous le menu, qui se remplit au défilement.
 * Réalisée en CSS scroll-driven (`animation-timeline: scroll()`) : AUCUN
 * JavaScript, donc aucun impact sur la performance ni sur la lecture par les IA.
 * Amélioration progressive : masquée si les animations liées au scroll ne sont
 * pas supportées ou si l'utilisateur préfère réduire les animations.
 */
---

<div class="reading-progress" aria-hidden="true">
  <span class="reading-progress__bar"></span>
</div>

<style>
  /* Par défaut masquée : on ne l'affiche que là où le scroll-driven fonctionne,
     pour ne jamais laisser une barre figée à 0 % sur un navigateur non compatible. */
  .reading-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .reading-progress {
      display: block;
      position: fixed;
      /* Juste sous l'en-tête sticky (min-height 4rem). */
      top: calc(4rem - 1px);
      left: 0;
      right: 0;
      height: 3px;
      z-index: 49;
      background: color-mix(in srgb, var(--blue) 10%, transparent);
      pointer-events: none;
    }
    .reading-progress__bar {
      display: block;
      height: 100%;
      transform-origin: 0 50%;
      transform: scaleX(0);
      background: var(--grad-brand);
      box-shadow: var(--shadow-glow);
      animation: reading-progress-grow linear both;
      animation-timeline: scroll(root block);
    }
  }

  @keyframes reading-progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      display: none;
    }
  }
</style>
