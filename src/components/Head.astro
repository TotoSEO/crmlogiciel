---
/**
 * Head / SEO — crm-logiciel.fr
 * Rendu à l'intérieur du <head> par BaseLayout. Produit l'ensemble des balises
 * SEO essentielles dans le HTML source : title, meta description, canonical
 * auto-référent (slash final), robots, OpenGraph, Twitter Card, favicon,
 * préchargement des polices critiques. Le JSON-LD est injecté via le slot
 * « head » de BaseLayout (jamais via un gestionnaire de balises).
 */
import { SITE, absoluteUrl } from '../config/site';

interface Props {
  /** Titre de la page (sans la marque ; la marque est ajoutée sauf rawTitle). */
  title: string;
  description: string;
  /** Slug servant au canonical auto-référent ('' = accueil). */
  canonicalSlug: string;
  ogType?: 'website' | 'article';
  /** Chemin ou URL de l'image OG ; défaut : image de marque. */
  ogImage?: string;
  /** Texte alternatif de l'image OG (défaut : nom du site). */
  ogImageAlt?: string;
  /** Dimensions de l'image OG (défaut : image de marque 1200x630). */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Désactive l'indexation (pages techniques / brouillons). */
  noindex?: boolean;
  /** Empêche l'ajout automatique de « · crm-logiciel.fr » au titre. */
  rawTitle?: boolean;
  /** Dates ISO 8601 pour les pages de type article. */
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonicalSlug,
  ogType = 'website',
  ogImage = SITE.defaultOgImage,
  ogImageAlt = SITE.name,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  noindex = false,
  rawTitle = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = rawTitle ? title : `${title} · ${SITE.name}`;
const canonical = absoluteUrl(canonicalSlug);
const ogImageUrl = new URL(ogImage, SITE.url).href;
// Lancement : tout le site est indexable, aucun noindex n'est jamais émis.
const robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#6457F9" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

{/* OpenGraph */}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={ogImageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

{/* Twitter Card */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
{SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}

{/* Favicon */}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

{/* Préchargement des polices critiques (corps + titre du hero) */}
<link
  rel="preload"
  href="/fonts/archivo-latin-400-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/space-grotesk-latin-700-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
