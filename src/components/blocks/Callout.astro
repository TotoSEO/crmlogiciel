---
/**
 * Callout — encadré de mise en avant (charte §04), en verre dépoli teinté.
 * Tons : astuce (orange), a-retenir (violet), note (teal), attention (corail).
 */
type Tone = 'astuce' | 'a-retenir' | 'note' | 'attention';

interface Props {
  tone?: Tone;
  title?: string;
}

const { tone = 'note', title } = Astro.props;

const TONES: Record<Tone, { label: string; palette: string; icon: string }> = {
  astuce: { label: 'Astuce', palette: 'orange', icon: '💡' },
  'a-retenir': { label: 'À retenir', palette: 'blue', icon: '📌' },
  note: { label: 'Note', palette: 'teal', icon: 'ℹ️' },
  attention: { label: 'Attention', palette: 'minium', icon: '⚠️' },
};

const t = TONES[tone];
const heading = title ?? t.label;
---

<aside
  class={`callout glass not-prose callout--${tone}`}
  style={`--c: var(--${t.palette}); --glass-tint: var(--${t.palette});`}
>
  <span class="callout__rail" aria-hidden="true"></span>
  <p class="callout__label">
    <span class="callout__icon" aria-hidden="true">{t.icon}</span>
    {heading}
  </p>
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    margin-block: var(--space-6);
    padding: var(--space-5) var(--space-6) var(--space-5) var(--space-8);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  /* Rail de couleur du ton, sur le bord gauche. */
  .callout__rail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background: var(--c);
    z-index: 1;
  }
  .callout__label {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-family: var(--font-ui);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--c) 80%, var(--ink));
  }
  .callout__icon {
    font-size: var(--text-base);
  }
  .callout__body {
    position: relative;
    z-index: 1;
    color: var(--text-body);
    font-size: var(--text-base);
  }
  .callout__body :global(:last-child) {
    margin-bottom: 0;
  }
</style>
