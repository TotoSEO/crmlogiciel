---
/**
 * EnBref — encart « En bref » en tête d'article (roadmap §4), en verre dépoli.
 * Liste de 3 à 5 points clés, accent de marque.
 */
import { inlineMd } from '../../lib/inline-md';

interface Props {
  points: string[];
  title?: string;
}
const { points, title = 'En bref' } = Astro.props;
---

<aside class="enbref glass not-prose" style="--glass-tint: var(--blue)" aria-label={title}>
  <p class="enbref__title">
    <span class="enbref__dot" aria-hidden="true"></span>
    {title}
  </p>
  <ul class="enbref__list">
    {points.map((p) => <li set:html={inlineMd(p)} />)}
  </ul>
</aside>

<style>
  .enbref {
    margin-block: var(--space-6);
    padding: var(--space-6) var(--space-8);
    border-radius: var(--radius-xl);
  }
  .enbref > * {
    position: relative;
    z-index: 1;
  }
  .enbref__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    font-family: var(--font-ui);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--blue-ink);
  }
  .enbref__dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: var(--radius-full);
    background: var(--grad-brand);
    box-shadow: var(--shadow-glow);
  }
  .enbref__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .enbref__list li {
    position: relative;
    padding-left: var(--space-6);
    color: var(--text-body);
    font-size: var(--text-base);
  }
  .enbref__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.85rem;
    height: 0.5rem;
    border-left: 2px solid var(--blue);
    border-bottom: 2px solid var(--blue);
    transform: rotate(-45deg);
  }
</style>
