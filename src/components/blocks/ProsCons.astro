---
/**
 * ProsCons — Avantages / Inconvénients en deux panneaux de verre dépoli.
 * Vert = positif, corail = négatif. Titres en H3.
 */
interface Props {
  prosTitle?: string;
  consTitle?: string;
  pros: string[];
  cons: string[];
}

const { prosTitle = 'Avantages', consTitle = 'Inconvénients', pros, cons } = Astro.props;
---

<div class="proscons not-prose">
  <section class="proscons__col proscons__col--pros glass" style="--glass-tint: var(--green)">
    <h3 class="proscons__title">
      <span class="proscons__mark" aria-hidden="true">+</span>
      {prosTitle}
    </h3>
    <ul>
      {pros.map((p) => <li>{p}</li>)}
    </ul>
  </section>

  <section class="proscons__col proscons__col--cons glass" style="--glass-tint: var(--minium)">
    <h3 class="proscons__title">
      <span class="proscons__mark" aria-hidden="true">−</span>
      {consTitle}
    </h3>
    <ul>
      {cons.map((c) => <li>{c}</li>)}
    </ul>
  </section>
</div>

<style>
  .proscons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-block: var(--space-6);
  }
  .proscons__col {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
  }
  .proscons__col > * {
    position: relative;
    z-index: 1;
  }
  .proscons__col--pros {
    box-shadow: var(--shadow-soft), var(--shadow-pop-teal), var(--glass-highlight);
  }
  .proscons__col--cons {
    box-shadow:
      var(--shadow-soft),
      4px 4px 0 var(--minium),
      var(--glass-highlight);
  }
  .proscons__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }
  .proscons__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: var(--radius-full);
    font-weight: var(--font-weight-bold);
    color: #fff;
    box-shadow: var(--shadow-raise);
  }
  .proscons__col--pros .proscons__mark {
    background: var(--green);
  }
  .proscons__col--cons .proscons__mark {
    background: var(--minium);
  }
  .proscons ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .proscons li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-base);
    color: var(--text-body);
  }
  .proscons li::before {
    position: absolute;
    left: 0;
    top: 0.05em;
    font-weight: var(--font-weight-bold);
  }
  .proscons__col--pros li::before {
    content: '✓';
    color: var(--green-ink);
  }
  .proscons__col--cons li::before {
    content: '✕';
    color: var(--minium-ink);
  }

  @media (max-width: 640px) {
    .proscons {
      grid-template-columns: 1fr;
    }
  }
</style>
