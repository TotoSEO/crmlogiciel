---
/**
 * PullQuote — citation mise en avant (charte §04), sur verre dépoli.
 * Auteur + rôle + initiales dans une pastille dégradée.
 */
interface Props {
  author?: string;
  role?: string;
  initials?: string;
}
const { author, role, initials } = Astro.props;
---

<figure class="pullquote glass not-prose" style="--glass-tint: var(--blue)">
  <span class="pullquote__bigmark" aria-hidden="true">“</span>
  <blockquote class="pullquote__quote">
    <slot />
  </blockquote>
  {
    (author || role) && (
      <figcaption class="pullquote__cite">
        {initials && (
          <span class="pullquote__avatar" aria-hidden="true">
            {initials}
          </span>
        )}
        <span>
          {author && <span class="pullquote__author">{author}</span>}
          {role && <span class="pullquote__role">{role}</span>}
        </span>
      </figcaption>
    )
  }
</figure>

<style>
  .pullquote {
    margin-block: var(--space-8);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
  }
  .pullquote__bigmark {
    position: absolute;
    top: -0.15em;
    left: var(--space-5);
    z-index: 1;
    font-family: var(--font-display);
    font-size: 7rem;
    line-height: 1;
    background: var(--grad-iris);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.5;
  }
  .pullquote__quote {
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-snug);
    color: var(--ink);
    text-wrap: balance;
  }
  .pullquote__cite {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .pullquote__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--radius-full);
    background: var(--grad-cool);
    color: #fff;
    font-family: var(--font-ui);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-sm);
    box-shadow: var(--shadow-glow);
  }
  .pullquote__author {
    display: block;
    font-weight: var(--font-weight-semibold);
    color: var(--ink);
  }
  .pullquote__role {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
