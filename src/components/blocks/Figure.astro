---
/**
 * Figure — image avec légende (charte §04 / roadmap §3), dans un cadre de verre.
 * Image responsive, lazy par défaut, légende optionnelle.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
  eager?: boolean;
}
const { src, alt, caption, width, height, eager = false } = Astro.props;
---

<figure class="figure glass" style="--glass-tint: var(--teal)">
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: var(--space-6);
    padding: var(--space-3);
    border-radius: var(--radius-xl);
  }
  .figure img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: var(--rule-hair) solid var(--glass-border);
  }
  .figure__caption {
    position: relative;
    z-index: 1;
    margin-top: var(--space-3);
    padding-inline: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-align: center;
  }
</style>
