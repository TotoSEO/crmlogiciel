---
/**
 * Figure — image avec légende (charte §04 / roadmap §3).
 * Image responsive, lazy par défaut, légende optionnelle.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
  /** Charger en priorité (au-dessus de la ligne de flottaison). */
  eager?: boolean;
}
const { src, alt, caption, width, height, eager = false } = Astro.props;
---

<figure class="figure">
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin-block: var(--space-6);
  }
  .figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: var(--rule-hair) solid var(--border-default);
    box-shadow: var(--shadow-raise);
  }
  .figure__caption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-align: center;
  }
</style>
