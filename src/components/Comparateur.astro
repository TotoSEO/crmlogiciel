---
/**
 * Comparateur CRM — module interactif (île Astro).
 *
 * À gauche on choisit un CRM, à droite un autre : le panneau central affiche la
 * comparaison (note globale, 6 critères en « faders », fiche factuelle, forces/
 * limites). Neutre par principe : il COMPARE, il ne recommande pas (le choix
 * personnalisé, c'est le configurateur de /comment-choisir-crm/).
 *
 * Rendu côté serveur : la paire par défaut est déjà dans la source (lisible sans
 * JS, sans saut de mise en page). Le <script> ne fait que reconstruire le panneau
 * au changement de sélection, via le MÊME panelHTML() que le serveur.
 */
import { CRMS, panelHTML, LAST_VERIFIED } from '../data/comparateur-crm';

const DEFAULT_A = 'hubspot';
const DEFAULT_B = 'salesforce';
---

<section class="cmp not-prose" aria-label="Comparateur de CRM" data-default-a={DEFAULT_A} data-default-b={DEFAULT_B}>
  <div class="cmp-pickers">
    <div class="cmp-pick cmp-pick--a">
      <label class="cmp-pick__label" id="cmp-a-label" for="cmp-a">Premier CRM</label>
      <div class="cmp-select-wrap">
        <select id="cmp-a" class="cmp-select" data-side="a" aria-labelledby="cmp-a-label">
          {CRMS.map((c) => <option value={c.id} selected={c.id === DEFAULT_A}>{c.name}</option>)}
        </select>
      </div>
    </div>

    <span class="cmp-pickers__vs" aria-hidden="true">VS</span>

    <div class="cmp-pick cmp-pick--b">
      <label class="cmp-pick__label" id="cmp-b-label" for="cmp-b">Second CRM</label>
      <div class="cmp-select-wrap">
        <select id="cmp-b" class="cmp-select" data-side="b" aria-labelledby="cmp-b-label">
          {CRMS.map((c) => <option value={c.id} selected={c.id === DEFAULT_B}>{c.name}</option>)}
        </select>
      </div>
    </div>
  </div>

  <div class="cmp-panel" set:html={panelHTML(DEFAULT_A, DEFAULT_B)}></div>

  <p class="cmp-legend">
    Notes sur 10 : synthèse éditoriale calibrée au marché (elles situent, elles ne tranchent pas).
    Tarifs indicatifs, HT, hors promotions, <strong>relevés en {LAST_VERIFIED}</strong>, à vérifier
    sur le site de l'éditeur. Ce comparateur aide à <em>comparer</em> : pour savoir lequel est fait
    pour vous, passez par le <a href="/comment-choisir-crm/">formulaire</a>.
  </p>
</section>

<script>
  import { panelHTML, CRMS } from '../data/comparateur-crm';

  const root = document.querySelector<HTMLElement>('.cmp');
  if (root) {
    const selA = root.querySelector<HTMLSelectElement>('#cmp-a')!;
    const selB = root.querySelector<HTMLSelectElement>('#cmp-b')!;
    const panel = root.querySelector<HTMLElement>('.cmp-panel')!;
    const sel = (side: 'a' | 'b') => (side === 'a' ? selA : selB);
    const other = (side: 'a' | 'b') => (side === 'a' ? selB : selA);

    const nameById = (id: string) => CRMS.find((c) => c.id === id)?.name ?? id;
    const logoHTML = (id: string) =>
      `<img class="cmp-combo__logo" src="/images/crm/${id}.png" alt="" width="26" height="26" loading="lazy" decoding="async">`;

    const combos: Record<'a' | 'b', HTMLElement> = {} as any;

    function buildCombo(side: 'a' | 'b'): HTMLElement {
      const s = sel(side);
      const labelId = `cmp-${side}-label`;
      const btnId = `cmp-${side}-btn`;
      const combo = document.createElement('div');
      combo.className = 'cmp-combo';
      combo.dataset.side = side;
      combo.innerHTML =
        `<button type="button" id="${btnId}" class="cmp-combo__btn" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="${labelId} ${btnId}">` +
        `<span class="cmp-combo__cur"></span><span class="cmp-combo__chev" aria-hidden="true"></span></button>` +
        `<ul class="cmp-combo__panel" role="listbox" aria-labelledby="${labelId}" hidden>` +
        CRMS.map(
          (c) =>
            `<li role="option" tabindex="-1" class="cmp-combo__opt" data-id="${c.id}" aria-selected="false">` +
            `${logoHTML(c.id)}<span class="cmp-combo__name">${c.name}</span><span class="cmp-combo__tick" aria-hidden="true">✓</span></li>`,
        ).join('') +
        `</ul>`;
      s.after(combo);
      return combo;
    }

    const btnOf = (side: 'a' | 'b') =>
      combos[side].querySelector<HTMLButtonElement>('.cmp-combo__btn')!;
    const listOf = (side: 'a' | 'b') => combos[side].querySelector<HTMLElement>('.cmp-combo__panel')!;
    const optsOf = (side: 'a' | 'b') =>
      Array.from(combos[side].querySelectorAll<HTMLElement>('.cmp-combo__opt'));

    function refreshCombo(side: 'a' | 'b') {
      const id = sel(side).value;
      const cur = combos[side].querySelector<HTMLElement>('.cmp-combo__cur')!;
      cur.innerHTML = `${logoHTML(id)}<span class="cmp-combo__name">${nameById(id)}</span>`;
      for (const opt of optsOf(side)) {
        const oid = opt.dataset.id!;
        const selected = oid === id;
        const disabled = oid === other(side).value;
        opt.setAttribute('aria-selected', selected ? 'true' : 'false');
        opt.classList.toggle('is-selected', selected);
        opt.classList.toggle('is-disabled', disabled);
        if (disabled) opt.setAttribute('aria-disabled', 'true');
        else opt.removeAttribute('aria-disabled');
      }
    }

    function closeCombo(side: 'a' | 'b') {
      listOf(side).hidden = true;
      btnOf(side).setAttribute('aria-expanded', 'false');
      combos[side].classList.remove('is-open');
    }
    const closeAll = () => {
      closeCombo('a');
      closeCombo('b');
    };
    function openCombo(side: 'a' | 'b') {
      closeAll();
      listOf(side).hidden = false;
      btnOf(side).setAttribute('aria-expanded', 'true');
      combos[side].classList.add('is-open');
      const target =
        combos[side].querySelector<HTMLElement>('.cmp-combo__opt.is-selected') || optsOf(side)[0];
      target?.focus();
    }

    function choose(side: 'a' | 'b', id: string) {
      if (id === other(side).value) return; // jamais deux fois le même CRM
      sel(side).value = id;
      sel(side).dispatchEvent(new Event('change', { bubbles: true }));
      closeCombo(side);
      btnOf(side).focus();
    }

    function keyNav(e: KeyboardEvent, side: 'a' | 'b') {
      const list = optsOf(side);
      const cur = (e.target as HTMLElement).closest<HTMLElement>('.cmp-combo__opt');
      let i = cur ? list.indexOf(cur) : 0;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        list[Math.min(list.length - 1, i + 1)].focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        list[Math.max(0, i - 1)].focus();
      } else if (e.key === 'Home') {
        e.preventDefault();
        list[0].focus();
      } else if (e.key === 'End') {
        e.preventDefault();
        list[list.length - 1].focus();
      } else if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (cur && !cur.classList.contains('is-disabled')) choose(side, cur.dataset.id!);
      } else if (e.key === 'Escape') {
        e.preventDefault();
        closeCombo(side);
        btnOf(side).focus();
      }
    }

    function syncDisabled() {
      for (const o of Array.from(selB.options)) o.disabled = o.value === selA.value;
      for (const o of Array.from(selA.options)) o.disabled = o.value === selB.value;
    }
    function render() {
      panel.innerHTML = panelHTML(selA.value, selB.value);
    }
    function onChange() {
      syncDisabled();
      render();
      refreshCombo('a');
      refreshCombo('b');
    }
    selA.addEventListener('change', onChange);
    selB.addEventListener('change', onChange);

    for (const side of ['a', 'b'] as const) {
      combos[side] = buildCombo(side);
      const btn = btnOf(side);
      const list = listOf(side);
      btn.addEventListener('click', () =>
        combos[side].classList.contains('is-open') ? closeCombo(side) : openCombo(side),
      );
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openCombo(side);
        }
      });
      list.addEventListener('click', (e) => {
        const opt = (e.target as HTMLElement).closest<HTMLElement>('.cmp-combo__opt');
        if (opt && !opt.classList.contains('is-disabled')) choose(side, opt.dataset.id!);
      });
      list.addEventListener('keydown', (e) => keyNav(e, side));
      refreshCombo(side);
    }

    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.cmp-combo')) closeAll();
    });

    syncDisabled();
    root.classList.add('cmp--js');
  }
</script>

<style>
  .cmp {
    --cmp-track: 0.62rem;
    position: relative;
    padding: clamp(var(--space-4), 3.5vw, var(--space-8));
    border-radius: var(--radius-2xl);
    border: var(--rule-hair) solid var(--border-default);
    background:
      radial-gradient(90% 55% at 50% 0%, var(--blue-tint), transparent 65%), var(--surface-card);
    box-shadow: var(--shadow-soft);
  }

  /* ---------- Sélecteurs (gauche / VS / droite) ---------- */
  .cmp-pickers {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: var(--space-3) var(--space-5);
    margin-bottom: var(--space-8);
  }
  .cmp-pick__label {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .cmp-pick--a .cmp-pick__label {
    color: var(--blue-ink);
  }
  .cmp-pick--b .cmp-pick__label {
    color: var(--blue-ink);
    text-align: right;
  }
  .cmp-select-wrap {
    position: relative;
  }
  .cmp-select-wrap::after {
    content: '';
    position: absolute;
    top: 50%;
    right: var(--space-4);
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid var(--ink-60);
    border-bottom: 2px solid var(--ink-60);
    transform: translateY(-65%) rotate(45deg);
    pointer-events: none;
  }
  .cmp-select {
    width: 100%;
    min-height: var(--tap-min);
    padding: var(--space-3) var(--space-8) var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    border: var(--rule-medium) solid var(--border-strong);
    background: var(--surface-card);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-lg);
    color: var(--ink);
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }
  .cmp-select:hover {
    border-color: var(--blue);
  }
  .cmp-select:focus-visible {
    outline: none;
    border-color: var(--blue);
    box-shadow: var(--shadow-glow);
  }
  .cmp-pickers__vs {
    align-self: center;
    margin-bottom: var(--space-1);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-sm);
    color: var(--text-faint);
    letter-spacing: var(--tracking-wide);
  }

  /* Sélecteur : le <select> natif (repli sans JS) est masqué dès que l'île JS
     construit le combo personnalisé. Le combo est stylé dans le bloc
     <style is:global> plus bas : ses éléments sont créés en JavaScript et ne
     portent donc pas l'attribut de portée (scope) d'Astro. */
  .cmp--js .cmp-select {
    display: none;
  }

  /* ---------- Têtes de comparaison ---------- */
  .cmp-panel :global(.cmp-heads) {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: var(--space-3) var(--space-4);
    margin-bottom: var(--space-8);
  }
  .cmp-panel :global(.cmp-head) {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-3) var(--space-5);
    text-align: center;
    border-radius: var(--radius-lg);
    border: var(--rule-hair) solid var(--border-default);
    border-top: 3px solid var(--c);
    background: color-mix(in srgb, var(--c) 6%, var(--surface-card));
  }
  .cmp-panel :global(.cmp-head__mono) {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    padding: 5px;
    border-radius: var(--radius-md);
    background: #fff;
    border: var(--rule-hair) solid var(--border-default);
    box-shadow: var(--shadow-soft);
  }
  .cmp-panel :global(.cmp-logo) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .cmp-panel :global(.cmp-head__name) {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-xl);
    color: var(--ink);
    line-height: 1.15;
  }
  .cmp-panel :global(.cmp-head__cat) {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    text-wrap: balance;
  }
  .cmp-panel :global(.cmp-head__global) {
    margin-top: var(--space-2);
    font-family: var(--font-data);
    font-feature-settings: var(--num-tabular);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-4xl);
    line-height: 1;
    color: var(--c);
  }
  .cmp-panel :global(.cmp-head__global small) {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-regular);
    color: var(--text-faint);
  }
  .cmp-panel :global(.cmp-vs) {
    display: grid;
    place-items: center;
    align-self: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-full);
    background: var(--surface-sunk);
    border: var(--rule-hair) solid var(--border-default);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* ---------- Critères notés (faders) ---------- */
  .cmp-panel :global(.cmp-criteria) {
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .cmp-panel :global(.cmp-crit) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8rem, auto) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
  }
  .cmp-panel :global(.cmp-crit__label) {
    text-align: center;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--ink-80);
    text-wrap: balance;
  }
  .cmp-panel :global(.cmp-fader) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .cmp-panel :global(.cmp-fader__who) {
    display: none; /* visible en mobile uniquement */
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    padding: 2px;
    place-items: center;
    border-radius: var(--radius-sm);
    background: #fff;
    border: var(--rule-hair) solid var(--border-default);
  }
  .cmp-panel :global(.cmp-fader__track) {
    position: relative;
    flex: 1;
    height: var(--cmp-track);
    border-radius: var(--radius-full);
    background: var(--surface-sunk);
    overflow: hidden;
  }
  .cmp-panel :global(.cmp-fader__fill) {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--v);
    border-radius: var(--radius-full);
    background: var(--c);
  }
  .cmp-panel :global(.cmp-fader__val) {
    flex: none;
    min-width: 1.6rem;
    font-family: var(--font-data);
    font-feature-settings: var(--num-tabular);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-base);
    color: var(--c);
  }
  /* A = à gauche, remplissage vers le centre (droite de sa cellule) */
  .cmp-panel :global(.cmp-fader--a) {
    flex-direction: row-reverse;
  }
  .cmp-panel :global(.cmp-fader--a .cmp-fader__fill) {
    right: 0;
  }
  .cmp-panel :global(.cmp-fader--a .cmp-fader__val) {
    text-align: left;
  }
  /* B = à droite, remplissage vers le centre (gauche de sa cellule) */
  .cmp-panel :global(.cmp-fader--b .cmp-fader__fill) {
    left: 0;
  }
  .cmp-panel :global(.cmp-fader--b .cmp-fader__val) {
    text-align: right;
  }

  /* ---------- Fiche factuelle ---------- */
  .cmp-panel :global(.cmp-facts) {
    margin-bottom: var(--space-8);
    border-radius: var(--radius-lg);
    border: var(--rule-hair) solid var(--border-default);
    overflow: hidden;
  }
  .cmp-panel :global(.cmp-fact) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8rem, auto) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
  }
  .cmp-panel :global(.cmp-fact:nth-child(even)) {
    background: color-mix(in srgb, var(--surface-sunk) 45%, transparent);
  }
  .cmp-panel :global(.cmp-fact__label) {
    text-align: center;
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-80);
    align-self: center;
  }
  .cmp-panel :global(.cmp-fact__a),
  .cmp-panel :global(.cmp-fact__b) {
    font-size: var(--text-sm);
    color: var(--text-body);
    line-height: 1.35;
  }
  .cmp-panel :global(.cmp-fact__a) {
    text-align: right;
  }
  .cmp-panel :global(.cmp-fact__sub) {
    display: block;
    margin-top: 2px;
    font-size: var(--text-2xs);
    color: var(--text-muted);
    line-height: 1.3;
  }
  .cmp-panel :global(.cmp-yes) {
    font-weight: var(--font-weight-bold);
    color: var(--green-ink);
  }
  .cmp-panel :global(.cmp-no) {
    font-weight: var(--font-weight-bold);
    color: var(--text-muted);
  }

  /* ---------- Forces / limites ---------- */
  .cmp-panel :global(.cmp-proscons) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .cmp-panel :global(.cmp-pc) {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    border: var(--rule-hair) solid var(--border-default);
    border-top: 3px solid var(--c);
    background: var(--surface-card);
  }
  .cmp-panel :global(.cmp-pc__name) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-base);
    color: var(--ink);
  }
  .cmp-panel :global(.cmp-pc__mono) {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    padding: 2px;
    border-radius: var(--radius-sm);
    background: #fff;
    border: var(--rule-hair) solid var(--border-default);
  }
  .cmp-panel :global(.cmp-pc__list) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .cmp-panel :global(.cmp-pc__list li) {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-sm);
    color: var(--text-body);
    line-height: 1.35;
  }
  .cmp-panel :global(.cmp-pc__plus::before) {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green-ink);
    font-weight: var(--font-weight-bold);
  }
  .cmp-panel :global(.cmp-pc__minus::before) {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--minium-ink, var(--text-muted));
    font-weight: var(--font-weight-bold);
  }

  /* ---------- Légende ---------- */
  .cmp-legend {
    margin: var(--space-8) 0 0;
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }
  .cmp-legend a {
    color: var(--blue-ink);
    font-weight: var(--font-weight-semibold);
  }

  /* ---------- Animation de remplissage (amélioration progressive) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .cmp-panel :global(.cmp-fader__fill) {
      animation: cmp-grow 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes cmp-grow {
      from {
        width: 0;
      }
      to {
        width: var(--v);
      }
    }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 680px) {
    .cmp-pickers {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .cmp-pickers__vs {
      justify-self: center;
      margin: var(--space-1) 0;
    }
    .cmp-pick--b .cmp-pick__label {
      text-align: left;
    }

    /* Faders : empilés, pleine largeur, remplissage classique (gauche→droite). */
    .cmp-panel :global(.cmp-crit) {
      grid-template-columns: 1fr;
      gap: var(--space-1);
      padding: var(--space-3) 0;
      border-top: var(--rule-hair) solid var(--border-default);
    }
    .cmp-panel :global(.cmp-crit:first-child) {
      border-top: none;
    }
    .cmp-panel :global(.cmp-crit__label) {
      text-align: left;
      margin-bottom: var(--space-1);
    }
    .cmp-panel :global(.cmp-fader--a) {
      flex-direction: row;
    }
    .cmp-panel :global(.cmp-fader--a .cmp-fader__fill),
    .cmp-panel :global(.cmp-fader--b .cmp-fader__fill) {
      left: 0;
      right: auto;
    }
    .cmp-panel :global(.cmp-fader--a .cmp-fader__val),
    .cmp-panel :global(.cmp-fader--b .cmp-fader__val) {
      text-align: right;
    }
    .cmp-panel :global(.cmp-fader__who) {
      display: grid;
    }

