---
/**
 * NavItemLi — un cluster du menu principal : libellé de tête (déclencheur) +
 * déroulant en grille (carte « pilier » + satellites). Composant autonome
 * (styles inclus), utilisé dans le menu principal et le menu mobile.
 * Les entrées transverses (outils, CRM gratuits, test) vivent dans TopbarItem.
 */
import type { NavItem } from '../config/content-map';

interface Props {
  item: NavItem;
  currentPath: string;
}
const { item, currentPath } = Astro.props;
const isCurrent = (href: string): boolean => href === currentPath;
const clusterVars = (palette: string): string =>
  `--cluster-color: var(--${palette}); --cluster-tint: var(--${palette}-tint);`;
---

<li class="nav-item nav-item--has-children" style={clusterVars(item.palette)}>
  <span
    class:list={['nav-link', 'nav-link--trigger', { 'is-active': isCurrent(item.href) }]}
    role="button"
    aria-haspopup="true"
    tabindex="0"
  >
    <span class="nav-dot" aria-hidden="true"></span>
    {item.label}
    <span class="nav-caret" aria-hidden="true"></span>
  </span>
  <div class="submenu">
    <a
      class="submenu__pillar"
      href={item.href}
      aria-current={isCurrent(item.href) ? 'page' : undefined}
    >
      <span>{item.pillarLabel ?? `${item.label} : le guide complet`}</span>
      <span class="submenu__pillar-arrow" aria-hidden="true">→</span>
    </a>
    <ul class="submenu__grid">
      {
        (item.children ?? []).map((child) => (
          <li>
            <a
              href={child.href}
              class="submenu__card"
              aria-current={isCurrent(child.href) ? 'page' : undefined}
            >
              <span class="submenu__card-dot" aria-hidden="true" />
              <span class="submenu__card-label">{child.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</li>

<style>
  .nav-item {
    position: relative;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    font-family: var(--font-ui);
    font-weight: var(--font-weight-medium);
    font-size: var(--text-base);
    color: var(--ink-80);
    transition:
      color 0.18s ease,
      background 0.18s ease;
  }
  .nav-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--cluster-color, var(--ink-35));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--cluster-color, var(--ink-35)) 18%, transparent);
    transition: transform 0.18s ease;
  }
  .nav-link:hover,
  .nav-item--has-children:hover .nav-link,
  .nav-item--has-children:focus-within .nav-link {
    color: var(--cluster-color, var(--blue));
    background: var(--cluster-tint, var(--blue-tint));
    text-decoration: none;
  }
  .nav-link:hover .nav-dot {
    transform: scale(1.25);
  }
  .nav-link[aria-current='page'] {
    color: var(--cluster-color, var(--blue));
  }
  .nav-link--trigger {
    cursor: default;
  }
  .nav-link--trigger.is-active {
    color: var(--cluster-color, var(--blue));
  }
  .nav-caret {
    width: 0.42rem;
    height: 0.42rem;
    margin-left: 0.1rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    transition: transform 0.18s ease;
    opacity: 0.7;
  }
  .nav-item--has-children:hover .nav-caret,
  .nav-item--has-children:focus-within .nav-caret {
    transform: rotate(-135deg);
  }

  /* ---- Déroulant (desktop) ----
     Menu principal aligné à gauche : le déroulant s'ouvre vers la DROITE
     (ancré au bord gauche du déclencheur). */
  .submenu {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: 60;
    width: max-content;
    max-width: 36rem;
    margin: 0;
    padding: var(--space-3);
    background: var(--surface-card);
    border: var(--rule-hair) solid var(--border-default);
    border-top: var(--rule-strong) solid var(--cluster-color, var(--blue));
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-raise);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
  }
  .nav-item--has-children:hover .submenu,
  .nav-item--has-children:focus-within .submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .submenu__pillar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--cluster-tint, var(--blue-tint));
    color: var(--cluster-color, var(--blue));
    font-family: var(--font-ui);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-sm);
  }
  .submenu__pillar:hover {
    background: color-mix(in srgb, var(--cluster-color, var(--blue)) 18%, transparent);
    color: var(--cluster-color, var(--blue));
    text-decoration: none;
  }
  .submenu__pillar-arrow {
    transition: transform 0.18s ease;
  }
  .submenu__pillar:hover .submenu__pillar-arrow {
    transform: translateX(3px);
  }
  .submenu__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .submenu__card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: 1.25;
    color: var(--ink-80);
  }
  .submenu__card-dot {
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-full);
    background: var(--cluster-color, var(--ink-35));
    opacity: 0.5;
    transition:
      transform 0.18s ease,
      opacity 0.18s ease;
  }
  .submenu__card:hover,
  .submenu__card[aria-current='page'] {
    background: var(--cluster-tint, var(--blue-tint));
    color: var(--cluster-color, var(--blue));
    text-decoration: none;
  }
  .submenu__card:hover .submenu__card-dot,
  .submenu__card[aria-current='page'] .submenu__card-dot {
    opacity: 1;
    transform: scale(1.3);
  }

  /* ---- Bande desktop étroite (861–1100px) ----
     Un déroulant 2 colonnes (36rem) déborderait à droite pour le dernier cluster.
     On l'empile sur une seule colonne, plus étroite, pour qu'il tienne. */
  @media (min-width: 861px) and (max-width: 1100px) {
    .submenu {
      width: 19rem;
      max-width: 19rem;
    }
    .submenu__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- Mobile : déroulant déplié dans le menu hamburger ---- */
  @media (max-width: 860px) {
    .nav-link {
      border-radius: var(--radius-md);
    }
    .nav-caret {
      display: none;
    }
    .submenu {
      position: static;
      z-index: auto;
      opacity: 1;
      visibility: visible;
      transform: none;
      width: auto;
      max-width: none;
      box-shadow: none;
      border: none;
      border-left: var(--rule-medium) solid var(--cluster-color, var(--blue));
      border-radius: 0;
      margin-left: var(--space-4);
      padding: var(--space-1) 0 var(--space-3) var(--space-3);
      transition: none;
    }
    .submenu__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .submenu__pillar {
      margin-bottom: var(--space-1);
    }
  }
</style>
