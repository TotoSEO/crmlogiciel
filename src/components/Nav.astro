---
/**
 * Navigation principale — crm-logiciel.fr (deux étages)
 *
 * 1. Sur-menu (.topbar) : barre supérieure NON sticky, alignée à droite, qui
 *    porte les trois entrées transverses — Boîte à outils, CRM gratuits et le
 *    Test de connaissances. Elle défile avec la page (disparaît au scroll).
 * 2. Menu principal (.site-header) : barre STICKY avec la marque et les clusters
 *    Comprendre / Choisir / Utiliser + Comparer les CRM.
 *
 * En mobile (≤ 860px), tout bascule dans le menu hamburger : les clusters puis,
 * sous un séparateur, les entrées du sur-menu. Menu mobile sans JavaScript (hack
 * de la case à cocher) ; déroulants desktop en CSS (hover + focus-within).
 * Chaque élément de nav est rendu par le composant autonome <NavItemLi>.
 */
import { navTree, topbarNav } from '../config/content-map';
import NavItemLi from './NavItemLi.astro';
import { path, SITE } from '../config/site';

const mainItems = navTree();
const topItems = topbarNav();
const home = path('');
const currentPath = path(Astro.url.pathname.replace(/^\/+|\/+$/g, ''));
---

{/* Sur-menu (non sticky) — masqué en mobile, où il bascule dans le hamburger */}
<div class="topbar">
  <div class="topbar__inner container">
    <nav class="topbar__nav" aria-label="Outils et raccourcis">
      <ul class="topbar__list">
        {topItems.map((item) => <NavItemLi item={item} currentPath={currentPath} />)}
      </ul>
    </nav>
  </div>
</div>

<header class="site-header">
  <div class="site-header__inner container">
    <a href={home} class="brand" aria-label={`${SITE.name}, accueil`}>
      <img class="brand__logo" src="/images/logo.png" alt={SITE.name} width="700" height="200" />
    </a>

    {/* Bascule mobile sans JS (hack case à cocher) */}
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-burger" aria-label="Ouvrir le menu">
      <span class="nav-burger__bar" aria-hidden="true"></span>
      <span class="nav-burger__bar" aria-hidden="true"></span>
      <span class="nav-burger__bar" aria-hidden="true"></span>
    </label>

    <nav class="primary-nav" aria-label="Navigation principale">
      <ul class="nav-list">
        {mainItems.map((item) => <NavItemLi item={item} currentPath={currentPath} />)}
        {/* Mobile uniquement : les entrées du sur-menu rejoignent le hamburger */}
        <li class="nav-list__top">
          <span class="nav-list__sep" aria-hidden="true"></span>
          <ul class="nav-list__top-list">
            {topItems.map((item) => <NavItemLi item={item} currentPath={currentPath} />)}
          </ul>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* ---- Sur-menu (barre supérieure, non sticky) ---- */
  .topbar {
    position: relative;
    background: var(--surface-sunk);
    border-bottom: var(--rule-hair) solid var(--border-default);
  }
  .topbar__inner {
    display: flex;
    justify-content: flex-end;
  }
  .topbar__list {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: var(--space-2) 0;
    list-style: none;
  }

  /* ---- Barre principale (sticky) ---- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--glass-bg-strong);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border-bottom: var(--rule-hair) solid var(--border-default);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 4rem;
  }

  /* ---- Marque ---- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-xl);
    color: var(--ink);
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand__logo {
    display: block;
    height: 2rem;
    width: auto;
  }
  @media (max-width: 420px) {
    .brand__logo {
      height: 1.7rem;
    }
  }

  /* ---- Liste de navigation principale (desktop) ---- */
  .nav-list {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Le groupe « sur-menu replié » n'existe qu'en mobile. */
  .nav-list__top {
    display: none;
  }

  /* ---- Bascule mobile (cachée en desktop) ---- */
  .nav-toggle,
  .nav-burger {
    display: none;
  }

  /* ---- Responsive : menu hamburger sans JS (≤ 860px) ----
     Deux barres + le sur-menu ne tiennent pas côte à côte sous ~860px : on
     replie tout dans le hamburger et on masque la barre supérieure (ses entrées
     réapparaissent en bas du menu déroulant, sous un séparateur). */
  @media (max-width: 860px) {
    .topbar {
      display: none;
    }

    .nav-burger {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: var(--tap-min);
      height: var(--tap-min);
      padding: 0 10px;
      cursor: pointer;
      border-radius: var(--radius-sm);
    }
    .nav-burger__bar {
      height: 2px;
      background: var(--ink);
      border-radius: 2px;
      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }

    .primary-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: 0;
      overflow: hidden;
      background: var(--surface-card);
      border-bottom: var(--rule-hair) solid var(--border-default);
      transition: max-height 0.28s ease;
    }
    .nav-toggle:checked ~ .primary-nav {
      max-height: 85vh;
      overflow-y: auto;
    }
    .nav-toggle:checked ~ .nav-burger .nav-burger__bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked ~ .nav-burger .nav-burger__bar:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle:checked ~ .nav-burger .nav-burger__bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-3) var(--space-5) var(--space-6);
    }
    /* Groupe « sur-menu » en bas du menu mobile */
    .nav-list__top {
      display: block;
    }
    .nav-list__sep {
      display: block;
      height: var(--rule-hair);
      margin: var(--space-3) 0;
      background: var(--border-default);
    }
    .nav-list__top-list {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }
</style>
