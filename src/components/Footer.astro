---
/**
 * Footer — crm-logiciel.fr
 * Colonnes par cluster (maillage interne dans la source) + bloc de marque.
 */
import { CLUSTERS, pagesOf, getPage } from '../config/content-map';
import { path, SITE } from '../config/site';

const navClusters = CLUSTERS.filter((c) => c.inNav);
const methodo = getPage('methodologie');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href={path('')} class="footer-brand">crm-logiciel<span>.fr</span></a>
      <p class="site-footer__pitch">
        Le média indépendant de référence sur les logiciels CRM en France : comprendre, choisir et
        utiliser un CRM, sans jargon.
      </p>
      {
        methodo && (
          <a href={path(methodo.slug)} class="site-footer__methodo">
            {methodo.label} →
          </a>
        )
      }
    </div>

    {
      navClusters.map((cluster) => (
        <nav class="site-footer__col" aria-label={cluster.label}>
          <h2 class="site-footer__title">{cluster.label}</h2>
          <ul>
            {pagesOf(cluster.id).map((page) => (
              <li>
                <a href={path(page.slug)}>{page.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="container site-footer__bottom">
    <p class="is-data">© {year} {SITE.name} · Tous droits réservés</p>
    <p class="is-data site-footer__since">Nom de domaine actif depuis 2007</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-24);
    background: var(--surface-sunk);
    border-top: var(--rule-hair) solid var(--border-default);
    padding-block: var(--space-16) var(--space-8);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: var(--space-10) var(--space-8);
  }
  .footer-brand {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-2xl);
    color: var(--ink);
  }
  .footer-brand span {
    color: var(--blue);
  }
  .site-footer__pitch {
    margin-top: var(--space-4);
    max-width: 34ch;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .site-footer__methodo {
    display: inline-block;
    margin-top: var(--space-5);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-sm);
  }
  .site-footer__title {
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: var(--space-4);
  }
  .site-footer__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .site-footer__col a {
    font-size: var(--text-sm);
    color: var(--ink-80);
  }
  .site-footer__col a:hover {
    color: var(--blue);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--rule-hair) solid var(--border-default);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  @media (max-width: 860px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
