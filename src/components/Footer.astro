---
/**
 * Footer — crm-logiciel.fr
 * Maillage interne resserré : liens vers les PILIERS uniquement (+ Méthodologie),
 * colonne utilitaire (pages prévues d'avance), bloc de marque.
 * Les intitulés de colonnes ne sont pas des Hn (pas de signal de titre concurrent).
 */
import { pillars, getPage, UTILITY_LINKS } from '../config/content-map';
import { path, SITE } from '../config/site';

const pillarLinks = pillars();
const methodo = getPage('methodologie');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href={path('')} class="footer-brand">crm-logiciel<span>.fr</span></a>
      <p class="site-footer__pitch">
        Le site de conseil en CRM n°1 en France depuis 2007. Comprendre, apprendre, comparer,
        choisir. Bienvenue sur notre site.
      </p>
      <p class="site-footer__since is-data">Nom de domaine actif depuis 2007</p>
    </div>

    <nav class="site-footer__col" aria-label="Nos guides">
      <p class="site-footer__title">Nos guides</p>
      <ul>
        {
          pillarLinks.map((p) => (
            <li>
              <a href={p.href} style={`--dot: var(--${p.palette})`}>
                <span class="dot" aria-hidden="true" />
                {p.label}
              </a>
            </li>
          ))
        }
        {
          methodo && (
            <li>
              <a href={path(methodo.slug)} style="--dot: var(--green)">
                <span class="dot" aria-hidden="true" />
                {methodo.label}
              </a>
            </li>
          )
        }
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Le site">
      <p class="site-footer__title">Le site</p>
      <ul>
        {
          UTILITY_LINKS.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <p class="is-data">© {year} {SITE.name} · Tous droits réservés</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-24);
    background: var(--surface-sunk);
    border-top: var(--rule-hair) solid var(--border-default);
    padding-block: var(--space-16) var(--space-8);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-10) var(--space-8);
  }
  .footer-brand {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-2xl);
    color: var(--ink);
  }
  .footer-brand span {
    color: var(--blue);
  }
  .site-footer__pitch {
    margin-top: var(--space-4);
    max-width: 38ch;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .site-footer__since {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .site-footer__title {
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }
  .site-footer__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .site-footer__col a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-80);
  }
  .site-footer__col a:hover {
    color: var(--blue);
  }
  .site-footer__col .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--dot, var(--ink-35));
    flex: none;
  }
  .site-footer__bottom {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--rule-hair) solid var(--border-default);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
