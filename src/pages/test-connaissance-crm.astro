---
/**
 * /test-connaissance-crm/ — Test de connaissances CRM interactif (brief dédié).
 *
 * Principe : tout le contenu (42 questions + options, chacune en H3) est rendu
 * côté serveur → lisible par les humains et les IA, sans JavaScript. L'interactivité
 * (déverrouillage progressif, scoring, partage) est une île JS ajoutée par-dessus.
 * Le JSON-LD Quiz embarque le corrigé COMPLET (chaque question, sa bonne réponse,
 * ses distracteurs et l'explication) au format « Education Q&A / practice problems »
 * de Google. Le corrigé est de toute façon déjà présent dans la source via les
 * données client de l'auto-test : l'exposer en JSON-LD n'ajoute aucune fuite.
 *
 * Les options sont mélangées de façon déterministe (graine = id) pour éviter que la
 * bonne réponse soit toujours en première position.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import Button from '../components/blocks/Button.astro';
import { INDEXABLE, absoluteUrl } from '../config/site';
import { organization, breadcrumbList, graph } from '../lib/schema';
import { QUESTIONS, THEMES, THEME_LABEL, type QuizQuestion } from '../data/quiz-crm';

const slug = 'test-connaissance-crm';
const TOTAL = QUESTIONS.length;

// Mélange déterministe des options (graine = id de la question).
function prepare(q: QuizQuestion) {
  const idx = q.options.map((_, i) => i);
  let s = q.id * 97 + 13;
  const rnd = () => {
    s = (s * 1103515245 + 12345) & 0x7fffffff;
    return s / 0x7fffffff;
  };
  for (let i = idx.length - 1; i > 0; i--) {
    const j = Math.floor(rnd() * (i + 1));
    [idx[i], idx[j]] = [idx[j], idx[i]];
  }
  return {
    id: q.id,
    theme: q.theme,
    question: q.question,
    options: idx.map((i) => q.options[i]),
    answer: idx.indexOf(q.answer),
    explanation: q.explanation,
  };
}
const prepared = QUESTIONS.map(prepare);

// Données embarquées pour l'île (corrigé + explications). Acceptable pour un auto-test.
const clientData = JSON.stringify({ questions: prepared, themes: THEMES }).replace(/</g, '\\u003c');

// Fil d'Ariane + JSON-LD.
const crumbs = [{ label: 'Accueil', href: '/' }, { label: 'Test de connaissances CRM' }];
const quizSchema = {
  '@type': 'Quiz',
  name: 'Test de connaissances CRM',
  description:
    'Quiz gratuit de 42 questions pour évaluer son niveau de connaissances sur les logiciels CRM, avec un score détaillé par thème.',
  educationalUse: 'Assessment',
  learningResourceType: 'Quiz',
  isAccessibleForFree: true,
  inLanguage: 'fr',
  about: { '@type': 'Thing', name: 'Gestion de la relation client (CRM)' },
  url: absoluteUrl(slug),
  numberOfQuestions: TOTAL,
  // Corrigé complet, format « Education Q&A » de Google : chaque question, sa
  // bonne réponse (acceptedAnswer + explication en commentaire) et ses distracteurs.
  hasPart: QUESTIONS.map((q) => ({
    '@type': 'Question',
    eduQuestionType: 'Multiple choice',
    text: q.question,
    learningResourceType: 'Practice problem',
    assesses: THEME_LABEL[q.theme],
    acceptedAnswer: {
      '@type': 'Answer',
      text: q.options[q.answer],
      comment: { '@type': 'Comment', text: q.explanation },
    },
    suggestedAnswer: q.options
      .filter((_, i) => i !== q.answer)
      .map((opt) => ({ '@type': 'Answer', text: opt })),
  })),
};
const pageSchema = graph(quizSchema, organization(), breadcrumbList(crumbs, absoluteUrl(slug)));
---

<BaseLayout
  title="Test de connaissances CRM en ligne et gratuit"
  description="Évaluez votre niveau en CRM avec notre quiz gratuit de 42 questions : score détaillé par thème et conseils pour progresser. En ligne, sans inscription."
  canonicalSlug={slug}
  ogType="website"
  rawTitle
  noindex={!INDEXABLE}
>
  <Fragment slot="head">
    <JsonLd schema={pageSchema} />
  </Fragment>

  {/* Barre de progression du quiz (gérée par JS, masquée sans JS). */}
  <div class="quiz-progress" hidden>
    <div class="container quiz-progress__inner">
      <span class="quiz-progress__label is-data">Question 1 / {TOTAL}</span>
      <span class="quiz-progress__track"><span class="quiz-progress__fill"></span></span>
    </div>
  </div>

  <div class="container qtop">
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <ol>
        <li><a href="/">Accueil</a></li>
        <li><span aria-current="page">Test de connaissances CRM</span></li>
      </ol>
    </nav>
  </div>

  {/* Hero spécial du quiz : fond animé, puces flottantes, entrées en cascade. */}
  <section class="qhero">
    <div class="qhero__decor" aria-hidden="true">
      <span class="qhero__blob qhero__blob--1"></span>
      <span class="qhero__blob qhero__blob--2"></span>
      <span class="qhero__blob qhero__blob--3"></span>
      <span class="qchip qchip--1"
        >Customer Relationship Management <em class="qchip__ok">✓</em></span
      >
      <span class="qchip qchip--2">Pipeline <em class="qchip__q">?</em></span>
      <span class="qchip qchip--3">RGPD <em class="qchip__ok">✓</em></span>
      <span class="qchip qchip--4">Churn <em class="qchip__ko">✗</em></span>
      <span class="qchip qchip--5">Lead scoring <em class="qchip__q">?</em></span>
    </div>

    <div class="container qhero__inner">
      <p class="qhero__eyebrow is-data anim-fade-up">
        <span class="qhero__pulse" aria-hidden="true"></span>
        Quiz gratuit · sans inscription
      </p>
      <h1 class="qhero__title anim-fade-up anim-delay-1">
        Testez vos connaissances <span class="qhero__hl gradient-animated">en CRM</span>, ou celles
        de vos équipes !
      </h1>
      <p class="qhero__lead anim-fade-up anim-delay-2">
        {TOTAL} questions, {THEMES.length} thèmes, un score détaillé et des pistes pour progresser. En
        quelques minutes, et la correction tombe à chaque réponse.
      </p>
      <ul class="qhero__stats anim-fade-up anim-delay-3">
        <li><strong class="is-data">{TOTAL}</strong><span>questions</span></li>
        <li><strong class="is-data">{THEMES.length}</strong><span>thèmes</span></li>
        <li><strong class="is-data">~5</strong><span>minutes</span></li>
        <li><strong class="is-data">0 €</strong><span>sans compte</span></li>
      </ul>
      <div class="qhero__cta anim-fade-up anim-delay-4">
        <Button href="#commencer" variant="primary">Commencer le test →</Button>
      </div>
    </div>
  </section>

  <article class="container quizpage">
    <h2 id="commencer">Commencez le test et découvrez votre niveau en CRM</h2>
    <p class="quizpage__howto">
      Répondez aux questions une à une : chaque réponse vous dit aussitôt si c'est juste ou faux,
      avec l'explication, puis débloque la suivante. À la fin, vous obtenez votre score global et le
      détail par thème, avec des liens pour combler vos points faibles.
    </p>

    {/* Le test — tout est rendu côté serveur (lisible sans JS). */}
    <ol class="quiz" aria-label="Questions du test">
      {
        prepared.map((q, i) => (
          <li class="q" id={`question-${q.id}`} data-q={q.id}>
            <div class="q__head">
              <span class="q__num is-data">Question {i + 1}</span>
              <span class="q__theme">{THEME_LABEL[q.theme]}</span>
            </div>
            <h3 class="q__title">{q.question}</h3>
            <ul class="q__opts" role="group" aria-label={`Réponses à la question ${i + 1}`}>
              {q.options.map((opt, oi) => (
                <li>
                  <button type="button" class="q-opt" data-i={oi}>
                    <span class="q-opt__bullet" aria-hidden="true" />
                    <span class="q-opt__text">{opt}</span>
                  </button>
                </li>
              ))}
            </ul>
            <span class="q__lock" aria-hidden="true">
              🔒 Répondez à la question précédente
            </span>
          </li>
        ))
      }
    </ol>

    {/* Résultats (remplis par JS) */}
    <section id="resultats" class="results" hidden aria-live="polite">
      <h3>Vos résultats</h3>
      <div class="results__scorewrap">
        <div class="results__score">
          <span class="results__scoreval is-data">0</span><span class="results__scoreunit">%</span>
        </div>
        <p class="results__comment"></p>
      </div>

      <p class="results__sub">Votre niveau par thème</p>
      <div class="results__themes"></div>

      <details class="results__recap">
        <summary>Voir le corrigé question par question</summary>
        <div class="results__recaplist"></div>
      </details>

      <div class="results__share">
        <p class="results__sharetitle">Partagez vos résultats sur les réseaux !</p>
        <div class="results__sharebtns">
          <a class="sharebtn" data-net="x" target="_blank" rel="noopener">X</a>
          <a class="sharebtn" data-net="wa" target="_blank" rel="noopener">WhatsApp</a>
          <a class="sharebtn" data-net="th" target="_blank" rel="noopener">Threads</a>
          <a class="sharebtn" data-net="li" target="_blank" rel="noopener">LinkedIn</a>
          <a class="sharebtn" data-net="fb" target="_blank" rel="noopener">Facebook</a>
          <button type="button" class="sharebtn sharebtn--copy">Copier mon résultat</button>
        </div>
      </div>

      <div class="results__actions">
        <Button variant="ghost"><span class="results__again">Refaire le test</span></Button>
      </div>
    </section>

    {/* Contenu SEO (présent dans la source) */}
    <section class="quizpage__seo">
      <h2>Pourquoi faire ce test de connaissances CRM ?</h2>
      <p>
        Ce test permet de situer son niveau réel sur le CRM en quelques minutes, de repérer ses
        angles morts et de transformer des notions floues en repères clairs. Il est utile avant de
        choisir ou de déployer un outil, pour préparer un échange avec un éditeur, ou pour former
        une équipe commerciale. Le score par thème montre précisément où l'on est solide et où il
        faut progresser. Gratuit, sans inscription, et refaisable autant de fois qu'on le souhaite.
      </p>

      <h2>Comment lire vos résultats ?</h2>
      <p>
        Le résultat se lit à deux niveaux : un score global, qui donne une appréciation d'ensemble,
        et un détail par thème, qui est le plus instructif. Un thème en dessous de 60 % signale une
        zone à consolider en priorité. À l'inverse, un thème au vert confirme un acquis. Chaque
        thème renvoie vers les guides du site pour combler les écarts : c'est la meilleure façon de
        transformer le test en progression réelle.
      </p>

      <h2>À qui s'adresse ce test ?</h2>
      <p>
        À tous les profils concernés par le CRM : dirigeants de TPE et PME, responsables et
        commerciaux, étudiants et personnes en reconversion, mais aussi équipes que l'on souhaite
        évaluer ou former. Aucune connaissance technique préalable n'est requise : les questions
        vont des fondamentaux aux sujets plus pointus comme le pilotage de la vente, le RGPD ou
        l'IA.
      </p>

      <h2>Comment progresser après le test ?</h2>
      <p>
        Selon les thèmes à renforcer, on peut approfondir directement sur le site. Pour les
        fondamentaux, commencer par <a href="/qu-est-ce-qu-un-crm/">qu'est-ce qu'un CRM</a> et le
        <a href="/lexique-crm/">lexique du CRM</a>. Pour le choix d'un outil, voir
        <a href="/comment-choisir-crm/">comment choisir son CRM</a> et le
        <a href="/cahier-des-charges-crm/">cahier des charges</a>. Pour le pilotage commercial,
        explorer le <a href="/pipeline-commercial/">pipeline commercial</a>, le
        <a href="/lead-scoring/">lead scoring</a> et le
        <a href="/tableau-de-bord-commercial/">tableau de bord commercial</a>. Pour la conformité,
        lire
        <a href="/crm-rgpd/">CRM et RGPD</a>.
      </p>
    </section>
  </article>

  <script type="application/json" id="quiz-data" set:html={clientData} is:inline />

  <script>
    type QData = {
      questions: {
        id: number;
        theme: string;
        question: string;
        options: string[];
        answer: number;
        explanation: string;
      }[];
      themes: { id: string; label: string; guides: { label: string; href: string }[] }[];
    };

    const dataEl = document.getElementById('quiz-data');
    const quizEl = document.querySelector<HTMLElement>('.quiz');
    if (dataEl && quizEl) {
      const data: QData = JSON.parse(dataEl.textContent || '{}');
      const byId = new Map(data.questions.map((q) => [q.id, q]));
      const themeById = new Map(data.themes.map((t) => [t.id, t]));
      const cards = Array.from(quizEl.querySelectorAll<HTMLElement>('.q'));
      const total = cards.length;
      const answers = new Map<number, number>();

      const progress = document.querySelector<HTMLElement>('.quiz-progress')!;
      const progressFill = progress.querySelector<HTMLElement>('.quiz-progress__fill')!;
      const progressLabel = progress.querySelector<HTMLElement>('.quiz-progress__label')!;
      const results = document.getElementById('resultats')!;

      quizEl.classList.add('quiz--js');
      progress.hidden = false;

      const qid = (card: HTMLElement) => Number(card.dataset.q);

      function setLocked(card: HTMLElement, locked: boolean) {
        card.classList.toggle('is-locked', locked);
        card.querySelectorAll<HTMLButtonElement>('.q-opt').forEach((b) => {
          b.tabIndex = locked ? -1 : 0;
          b.setAttribute('aria-disabled', locked ? 'true' : 'false');
        });
      }

      function updateProgress() {
        const done = answers.size;
        const current = Math.min(done + 1, total);
        progressLabel.textContent =
          done >= total ? `Terminé · ${total} / ${total}` : `Question ${current} / ${total}`;
        progressFill.style.transform = `scaleX(${done / total})`;
      }

      function init() {
        answers.clear();
        cards.forEach((card, i) => {
          card.classList.remove('is-answered', 'is-correct-card', 'is-wrong-card');
          card
            .querySelectorAll('.q-opt')
            .forEach((b) => b.classList.remove('is-chosen', 'is-correct', 'is-wrong'));
          card.querySelector('.q__feedback')?.remove();
          setLocked(card, i !== 0);
        });
        results.hidden = true;
        updateProgress();
      }

      quizEl.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.q-opt');
        if (!btn) return;
        const card = btn.closest<HTMLElement>('.q')!;
        if (card.classList.contains('is-locked') || card.classList.contains('is-answered')) return;

        const id = qid(card);
        const q = byId.get(id);
        const chosen = Number(btn.dataset.i);
        const correct = q ? q.answer : -1;
        const isOk = chosen === correct;

        answers.set(id, chosen);
        card.classList.add('is-answered', isOk ? 'is-correct-card' : 'is-wrong-card');
        card.querySelectorAll<HTMLButtonElement>('.q-opt').forEach((b) => {
          const bi = Number(b.dataset.i);
          b.tabIndex = -1;
          b.setAttribute('aria-disabled', 'true');
          if (bi === correct) b.classList.add('is-correct');
          else if (bi === chosen) b.classList.add('is-wrong');
        });

        // Feedback immédiat : verdict + explication (correction à chaque réponse).
        if (q) {
          const fb = document.createElement('div');
          fb.className = 'q__feedback ' + (isOk ? 'is-ok' : 'is-ko');
          fb.innerHTML =
            `<p class="q__verdict">${isOk ? '✓ Bonne réponse' : '✗ Mauvaise réponse'}</p>` +
            `<p class="q__expl">${esc(q.explanation)}</p>`;
          card.querySelector('.q__opts')?.insertAdjacentElement('afterend', fb);
        }

        updateProgress();

        // Déverrouille la suivante, puis défile en douceur : on cadre la correction
        // (verdict + explication) en haut, la question suivante apparaît juste en dessous.
        const idx = cards.indexOf(card);
        if (idx + 1 < total) {
          const next = cards[idx + 1];
          setLocked(next, false);
          const fbEl = card.querySelector<HTMLElement>('.q__feedback');
          setTimeout(() => {
            (fbEl ?? next).scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 450);
        } else {
          showResults();
        }
      });

      function comment(score: number): string {
        if (score < 40) return 'Découverte. Vous débutez sur le CRM : les bases vont vite venir.';
        if (score < 60)
          return 'En progression. Vous avez des repères, quelques notions clés restent à consolider.';
        if (score < 80)
          return 'Bon niveau. Vous maîtrisez l’essentiel, il reste des points pointus à creuser.';
        if (score < 95)
          return 'Confirmé. Solide sur le CRM, vous pourriez conseiller votre entourage.';
        return 'Expert CRM. Bravo, le sujet n’a (presque) plus de secret pour vous.';
      }

      function esc(s: string): string {
        const d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
      }

      function showResults() {
        let correct = 0;
        const per: Record<string, { c: number; t: number }> = {};
        data.questions.forEach((q) => {
          (per[q.theme] ||= { c: 0, t: 0 }).t++;
          if (answers.get(q.id) === q.answer) {
            correct++;
            per[q.theme].c++;
          }
        });
        const score = Math.round((correct / total) * 100);

        (results.querySelector('.results__comment') as HTMLElement).textContent = comment(score);

        // Barres par thème
        const themesHtml = data.themes
          .map((t) => {
            const p = per[t.id] || { c: 0, t: 0 };
            const pct = p.t ? Math.round((p.c / p.t) * 100) : 0;
            const weak = pct < 60;
            const links = weak
              ? `<p class="rtheme__links">À renforcer : ${t.guides
                  .map((g) => `<a href="${g.href}">${esc(g.label)}</a>`)
                  .join(', ')}</p>`
              : '';
            return `<div class="rtheme ${weak ? 'is-weak' : 'is-ok'}">
              <div class="rtheme__top"><span>${esc(t.label)}</span><span class="is-data">${pct} %</span></div>
              <div class="rtheme__bar"><span style="width:${pct}%"></span></div>${links}
            </div>`;
          })
          .join('');
        (results.querySelector('.results__themes') as HTMLElement).innerHTML = themesHtml;

        // Corrigé
        const recap = data.questions
          .map((q, i) => {
            const chosen = answers.get(q.id);
            const ok = chosen === q.answer;
            return `<div class="rrecap ${ok ? 'is-ok' : 'is-ko'}">
              <p class="rrecap__q"><span class="is-data">Q${i + 1}.</span> ${esc(q.question)}</p>
              <p class="rrecap__a">${ok ? '✓' : '✗'} Bonne réponse : <strong>${esc(q.options[q.answer])}</strong></p>
              <p class="rrecap__e">${esc(q.explanation)}</p>
            </div>`;
          })
          .join('');
        (results.querySelector('.results__recaplist') as HTMLElement).innerHTML = recap;

        // Partage
        const url = 'https://crm-logiciel.fr/test-connaissance-crm/';
        const text = `J'ai obtenu ${score} % au test de connaissances CRM 🎯 Et vous, vous maîtrisez vraiment le CRM ? Faites le test gratuit : ${url}`;
        const te = encodeURIComponent(text);
        const ue = encodeURIComponent(url);
        const tOnly = encodeURIComponent(
          `J'ai obtenu ${score} % au test de connaissances CRM 🎯 Et vous, vous maîtrisez vraiment le CRM ?`,
        );
        const set = (net: string, href: string) => {
          const el = results.querySelector<HTMLAnchorElement>(`.sharebtn[data-net="${net}"]`);
          if (el) el.href = href;
        };
        set('x', `https://twitter.com/intent/tweet?text=${tOnly}&url=${ue}`);
        set('wa', `https://wa.me/?text=${te}`);
        set('th', `https://www.threads.net/intent/post?text=${tOnly}&url=${ue}`);
        set('li', `https://www.linkedin.com/sharing/share-offsite/?url=${ue}`);
        set('fb', `https://www.facebook.com/sharer/sharer.php?u=${ue}`);

        const copyBtn = results.querySelector<HTMLButtonElement>('.sharebtn--copy');
        copyBtn?.addEventListener('click', () => {
          navigator.clipboard?.writeText(text).then(() => {
            copyBtn.textContent = 'Copié !';
            setTimeout(() => (copyBtn.textContent = 'Copier mon résultat'), 2000);
          });
        });

        results.hidden = false;
        progressFill.style.transform = 'scaleX(1)';
        progressLabel.textContent = `Terminé · ${total} / ${total}`;

        // Compteur animé
        const valEl = results.querySelector<HTMLElement>('.results__scoreval')!;
        let cur = 0;
        const step = Math.max(1, Math.round(score / 30));
        const tick = () => {
          cur = Math.min(score, cur + step);
          valEl.textContent = String(cur);
          if (cur < score) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        // Remplissage des barres après affichage
        requestAnimationFrame(() =>
          results.querySelectorAll<HTMLElement>('.rtheme__bar > span').forEach((b) => {
            const w = b.style.width;
            b.style.width = '0';
            requestAnimationFrame(() => (b.style.width = w));
          }),
        );

        results.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      results
        .querySelector('.results__again')
        ?.closest('a,button')
        ?.addEventListener('click', (e) => {
          e.preventDefault();
          init();
          cards[0]?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });

      init();
    }
  </script>
</BaseLayout>

<style>
  .quizpage {
    padding-block: var(--space-2) var(--space-16);
    max-width: 52rem;
  }
  .quizpage > h2:first-child {
    margin-top: var(--space-8);
  }
  .breadcrumb ol {
    display: flex;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .breadcrumb a {
    color: var(--text-muted);
  }
  .breadcrumb li:not(:last-child)::after {
    content: '›';
    margin-left: var(--space-2);
    color: var(--text-faint);
  }

  .qtop {
    padding-top: var(--space-8);
  }

  /* ========================= HERO SPÉCIAL DU QUIZ ========================= */
  .qhero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-12), 9vw, var(--space-24));
    text-align: center;
    background:
      radial-gradient(60% 70% at 50% -10%, var(--blue-tint) 0%, transparent 60%),
      radial-gradient(40% 50% at 12% 110%, var(--teal-tint) 0%, transparent 60%),
      radial-gradient(40% 50% at 90% 120%, var(--orange-tint) 0%, transparent 60%),
      linear-gradient(180deg, color-mix(in srgb, var(--blue-tint) 40%, #fff), #fff 80%);
  }
  .qhero__decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .qhero__blob {
    position: absolute;
    border-radius: var(--radius-blob);
    filter: blur(70px);
    opacity: 0.18;
  }
  .qhero__blob--1 {
    width: 26rem;
    height: 26rem;
    top: -8rem;
    left: -6rem;
    background: var(--grad-cool);
    animation: float-soft 10s ease-in-out infinite;
  }
  .qhero__blob--2 {
    width: 22rem;
    height: 22rem;
    top: -4rem;
