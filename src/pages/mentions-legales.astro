---
/**
 * /mentions-legales/ : page légale (LCEN, art. 6 III), éditeur professionnel
 * identifié (entrepreneur individuel, mention « EI » obligatoire).
 * Téléphone : jamais en clair dans le HTML ni le JS. Il est stocké encodé dans
 * `data-c` (chaque caractère XOR 23, ordre inversé, séparés par des virgules)
 * et reconstitué au clic sur « Afficher le numéro ». Hébergeur : Cloudflare.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import JsonLd from '../components/JsonLd.astro';
import { INDEXABLE, SITE, absoluteUrl } from '../config/site';
import { organization, breadcrumbList, graph } from '../lib/schema';

const crumbs = [{ label: 'Accueil', href: '/' }, { label: 'Mentions légales' }];
const pageSchema = graph(
  breadcrumbList(crumbs, absoluteUrl('mentions-legales')),
  organization(),
);
---

<BaseLayout
  title="Mentions légales"
  description="Mentions légales du site crm-logiciel.fr : éditeur, directeur de la publication, hébergeur et conditions d'utilisation."
  canonicalSlug="mentions-legales"
  noindex={!INDEXABLE}
>
  <Fragment slot="head">
    <JsonLd schema={pageSchema} />
  </Fragment>

  <div class="container legal">
    <Breadcrumb crumbs={crumbs} />
    <h1 class="legal__title">Mentions légales</h1>
    <p class="legal__updated is-data">Dernière mise à jour : 12 octobre 2026</p>

    <div class="prose">
      <h2>Éditeur du site</h2>
      <p>
        Le site <strong>crm-logiciel.fr</strong> est édité par <strong>Thomas Owaller (EI)</strong>,
        entrepreneur individuel (micro-entreprise).
      </p>
      <ul>
        <li>SIREN : 940 106 800</li>
        <li>Adresse : 4 rue de Bruges, 67000 Strasbourg, France</li>
        <li>E-mail : <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></li>
        <li>
          Téléphone :
          <button
            type="button"
            class="reveal-phone"
            data-c="39,34,55,39,39,55,37,32,55,37,47,55,32,39">Afficher le numéro</button
          >
        </li>
      </ul>

      <h2>Directeur de la publication</h2>
      <p>Thomas Owaller (EI)</p>

      <h2>Classements et liens d'intérêts</h2>
      <p>
        Les classements publiés sur crm-logiciel.fr reposent sur des critères éditoriaux décrits dans
        chaque classement et sur la page <a href="/a-propos/#classements">À propos</a>. Leur ordre
        reflète une appréciation éditoriale et peut évoluer.
      </p>
      <p>
        L'éditeur du site entretient des liens professionnels avec l'un des éditeurs de logiciels
        présentés dans ces classements ; chaque page de classement le signale en tête d'article. Le
        site n'affiche aucune publicité et ne contient aucun lien affilié.
      </p>
      <p>
        Les éditeurs cités peuvent demander la correction d'une information ou le retrait d'un
        visuel en écrivant à <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> :
        chaque demande justifiée est traitée rapidement.
      </p>

      <h2>Hébergeur</h2>
      <p>
        Le site est hébergé par :<br />
        <strong>Cloudflare, Inc.</strong><br />
        101 Townsend Street, San Francisco, CA 94107, États-Unis<br />
        <a href="https://www.cloudflare.com" rel="noopener nofollow" target="_blank">www.cloudflare.com</a>
      </p>

      <h2>Propriété intellectuelle</h2>
      <p>
        L'ensemble des contenus présents sur crm-logiciel.fr (textes, visuels, éléments graphiques,
        structure et mise en forme) est protégé par le droit d'auteur. Toute reproduction,
        représentation, modification ou diffusion, totale ou partielle, sans autorisation préalable
        de l'éditeur, est interdite, sous réserve des exceptions prévues par la loi (courte citation
        avec mention de la source, notamment).
      </p>
      <p>
        Les noms, logos et captures d'écran des logiciels cités restent la propriété de leurs
        éditeurs respectifs. Ils sont reproduits à des fins d'information et d'identification, avec
        mention de leur origine.
      </p>

      <h2>Responsabilité</h2>
      <p>
        Les informations publiées sur crm-logiciel.fr sont fournies à titre indicatif et informatif.
        Malgré le soin apporté à leur rédaction et à leur mise à jour, l'éditeur ne peut garantir
        leur exhaustivité ni leur parfaite exactitude à tout instant, et ne saurait être tenu
        responsable des décisions prises sur la seule base de ces contenus.
      </p>
      <p>
        Le site peut contenir des liens vers des sites tiers, sur le contenu desquels l'éditeur
        n'exerce aucun contrôle et décline toute responsabilité.
      </p>

      <h2>Données personnelles</h2>
      <p>
        Le traitement des données personnelles est détaillé dans notre
        <a href="/politique-de-confidentialite/">politique de confidentialité</a>.
      </p>

      <h2>Droit applicable</h2>
      <p>Les présentes mentions légales sont régies par le droit français.</p>
    </div>
  </div>
</BaseLayout>

<script>
  // Numéro reconstitué uniquement au clic (protection contre l'aspiration).
  document.querySelectorAll<HTMLButtonElement>('.reveal-phone').forEach((btn) => {
    btn.addEventListener('click', () => {
      const n = (btn.dataset.c || '')
        .split(',')
        .map((x) => String.fromCharCode(Number(x) ^ 23))
        .reverse()
        .join('');
      const a = document.createElement('a');
      a.href = 'tel:+33' + n.replace(/\s/g, '').slice(1);
      a.textContent = n;
      btn.replaceWith(a);
    });
  });
</script>

<style>
  .reveal-phone {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--space-3);
    border: var(--rule-hair) solid var(--border-default);
    border-radius: var(--radius-sm);
    background: var(--surface-card);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--ink-80);
    cursor: pointer;
  }
  .reveal-phone:hover {
    border-color: var(--blue);
    color: var(--blue-ink);
  }
  .legal {
    max-width: 48rem;
    padding-block: var(--space-10) var(--space-16);
  }
  .legal__title {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-5xl));
  }
  .legal__updated {
    margin-top: var(--space-2);
    margin-bottom: var(--space-8);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
