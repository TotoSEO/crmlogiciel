---
/**
 * /quel-crm/ — page « maison » du configurateur (page outil pure, en noindex).
 * L'autorité SEO reste sur C2-00 (« comment choisir un CRM ») pour éviter la
 * cannibalisation ; cette page concentre l'outil et reçoit les liens internes.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Configurateur from '../components/Configurateur.astro';

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Comment choisir son CRM', href: '/comment-choisir-crm/' },
  { label: 'Quel CRM est fait pour vous ?' },
];
---

<BaseLayout
  title="Quel CRM est fait pour vous ? Le configurateur"
  description="Répondez à 8 questions et notre configurateur vous recommande les CRM les plus adaptés à votre taille, votre budget et vos besoins. Gratuit, en 2 minutes."
  canonicalSlug="quel-crm"
  noindex
>
  <div class="container qc">
    <Breadcrumb crumbs={crumbs} />
    <header class="qc__head">
      <p class="qc__eyebrow is-data">Configurateur · 2 minutes</p>
      <h1>Quel CRM est fait pour vous ?</h1>
      <p class="qc__lead">
        Pas le temps de tout comparer ? Répondez à quelques questions : nous appliquons pour vous la
        grille des cinq critères et nous vous recommandons les outils les plus adaptés à votre
        situation.
      </p>
    </header>

    <Configurateur />

    <p class="qc__back">
      Besoin de comprendre la méthode d'abord ?
      <a href="/comment-choisir-crm/">Lire le guide « Comment choisir son CRM »</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .qc {
    max-width: 52rem;
    padding-block: var(--space-10) var(--space-16);
  }
  .qc__head {
    margin-bottom: var(--space-8);
    text-align: center;
  }
  .qc__eyebrow {
    margin-bottom: var(--space-3);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--blue);
  }
  .qc__head h1 {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl));
  }
  .qc__lead {
    margin: var(--space-5) auto 0;
    max-width: 46ch;
    font-size: var(--text-xl);
    color: var(--text-muted);
  }
  .qc__back {
    margin-top: var(--space-10);
    text-align: center;
    font-size: var(--text-base);
    color: var(--text-muted);
  }
  .qc__back a {
    color: var(--blue-ink);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
  }
</style>
