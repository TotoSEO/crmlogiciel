---
/**
 * Accueil — crm-logiciel.fr (Phase 2b).
 * Construit d'après la proposition de home N1-01 : hero « héritage 2007 / de
 * retour », bandeau de transition, timeline de guides (le cœur), grille « par
 * besoin », section de confiance EEAT, bandeau CTA final.
 *
 * Réconciliation avec l'arborescence de lancement (27 URLs) : le configurateur
 * (/quel-crm/), le comparatif, les pages CRM gratuit et CRM par secteur sont
 * DIFFÉRÉS. Ils sont présentés en mode « prochainement » (badge, sans lien), ou
 * remplacés par des pages de lancement réelles dans la grille « par besoin ».
 * Tout le contenu est dans le HTML source ; le seul JS éventuel (reveal) est en
 * CSS scroll-driven, sans script.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import Button from '../components/blocks/Button.astro';
import Badge from '../components/blocks/Badge.astro';
import FeatureGrid from '../components/blocks/FeatureGrid.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import { SITE, INDEXABLE, path } from '../config/site';
import { DEFAULT_AUTHOR } from '../config/site';
import { organization, website, graph } from '../lib/schema';

const homeSchema = graph(organization(), website());

// Les étapes de la timeline (guides). `soon` = différé → présenté « prochainement ».
const guides = [
  {
    n: 1,
    title: "Qu'est-ce qu'un CRM ?",
    text: "Pour commencer, si vous ne savez pas exactement ce qu'est un CRM ni ce qu'il peut changer pour votre entreprise, découvrez-le dans notre guide complet.",
    href: path('qu-est-ce-qu-un-crm'),
  },
  {
    n: 2,
    title: 'Les différents types de CRM',
    text: "Tous les CRM ne se ressemblent pas. Comprenez les grandes familles d'outils pour repérer celle qui correspond à vos priorités.",
    href: path('types-de-crm'),
  },
  {
    n: 3,
    title: "Les fonctionnalités d'un CRM",
    text: "Contacts, pipeline, automatisation, reporting : passez en revue ce qu'un bon CRM doit savoir faire, pour ne payer que ce qui vous sert vraiment.",
    href: path('fonctionnalites-crm'),
  },
  {
    n: 4,
    title: 'Comment choisir son CRM',
    text: "Vous y voyez plus clair ? Place à la méthode : nos critères pour choisir l'outil adapté à votre taille, votre budget et votre métier.",
    href: path('comment-choisir-crm'),
  },
  {
    n: 5,
    title: 'Quel CRM est fait pour vous ?',
    text: 'Pas le temps de tout lire ? Notre configurateur répondra à quelques questions pour vous recommander les outils les plus adaptés à votre profil.',
    soon: true,
  },
];
---

<BaseLayout
  title={SITE.longName}
  description={SITE.description}
  canonicalSlug=""
  ogType="website"
  rawTitle
  noindex={!INDEXABLE}
>
  <Fragment slot="head">
    <JsonLd schema={homeSchema} />
  </Fragment>

  {/* ======================== 1. HERO ======================== */}
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__main">
        <p class="hero__eyebrow is-data">Le blog français du CRM depuis 2007</p>
        <h1 class="hero__title">
          crm-logiciel.fr, le blog français <span class="degrade">n°1 du CRM</span>
        </h1>
        <p class="hero__lead">
          Après des années de silence, la référence française du CRM est de retour. La mission n'a
          pas changé : vous aider à trouver le logiciel qu'il vous faut, gratuitement et sans parti
          pris.
        </p>
        <div class="hero__cta">
          <Button href="#guides" variant="primary">Trouver mon CRM</Button>
          <Button href={path('qu-est-ce-qu-un-crm')} variant="ghost">Comprendre le CRM</Button>
        </div>
        <ul class="hero__trust">
          <li>Tests indépendants</li>
          <li>Sans publicité déguisée</li>
          <li>Mis à jour en continu</li>
        </ul>
      </div>

      {/* Visuel : pipeline CRM stylisé (décoratif). */}
      <div class="hero__visual" aria-hidden="true">
        <div class="hv glass">
          <div class="hv__bar">
            <span></span><span></span><span></span>
          </div>
          <div class="hv__board">
            <div class="hv__col">
              <span class="hv__coltitle">Contact</span>
              <span class="hv__card"></span>
              <span class="hv__card hv__card--sm"></span>
            </div>
            <div class="hv__col">
              <span class="hv__coltitle">Proposition</span>
              <span class="hv__card hv__card--accent"></span>
              <span class="hv__card"></span>
            </div>
            <div class="hv__col">
              <span class="hv__coltitle">Signé</span>
              <span class="hv__card hv__card--won"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ======================== 2. BANDEAU « DE RETOUR » ======================== */}
  <section class="comeback">
    <div class="container">
      <p>
        Pionnier du CRM en ligne depuis 2007, <strong>crm-logiciel.fr</strong> revient avec une ambition
        intacte : redevenir le guide de référence pour choisir son outil.
      </p>
    </div>
  </section>

  {/* ======================== 3. TIMELINE DES GUIDES ======================== */}
  <section id="guides" class="guides">
    <div class="container">
      <header class="section-head">
        <h2>Trouvez le CRM qu'il vous faut, étape par étape</h2>
        <p>
          Pas besoin d'être expert. Suivez le parcours : chaque guide vous rapproche du bon choix,
          dans le bon ordre.
        </p>
      </header>

      <ol class="timeline">
        {
          guides.map((g) => (
            <li class="tl-item">
              <span class="tl-pastille is-data">{g.n}</span>
              <div class="tl-card glass">
                <h3 class="tl-card__title">{g.title}</h3>
                <p class="tl-card__text">{g.text}</p>
                {g.href ? (
                  <a class="tl-card__link" href={g.href}>
                    Lire le guide <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  <Badge tone="accent">Prochainement</Badge>
                )}
              </div>
            </li>
          ))
        }

        {/* Étape finale : le comparatif (différé). */}
        <li class="tl-item tl-item--final">
          <span class="tl-pastille tl-pastille--final" aria-hidden="true">★</span>
          <div class="tl-card tl-card--final glass">
            <Badge tone="accent" pop>Prochainement</Badge>
            <h3 class="tl-card__title">Notre comparatif des meilleurs CRM pour 2027</h3>
            <p class="tl-card__text">
              L'aboutissement de votre recherche : le classement complet des meilleurs CRM, testés
              un par un. En préparation, disponible très bientôt.
            </p>
            <form class="notify" aria-label="Être prévenu du lancement du comparatif">
              <input
                type="email"
                class="notify__input"
                placeholder="Disponible au lancement"
                aria-label="Votre adresse e-mail"
                disabled
              />
              <Button variant="primary" type="button">Prévenez-moi</Button>
            </form>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {/* ======================== 4. EXPLORER PAR BESOIN ======================== */}
  <section class="byneed">
    <div class="container">
      <header class="section-head">
        <h2>Ou explorez selon votre besoin</h2>
      </header>
      <FeatureGrid cols={3}>
        <FeatureCard
          icon="🚀"
          title="Mettre en place un CRM"
          palette="orange"
          href={path('mise-en-place-crm')}
          cta="Voir la méthode"
        >
          La méthode pour réussir le déploiement et l'adoption par l'équipe.
        </FeatureCard>
        <FeatureCard
          icon="💶"
          title="Combien coûte un CRM"
          palette="teal"
          href={path('prix-crm')}
          cta="Décoder les prix"
        >
          Paliers, options, coûts cachés : le vrai budget d'un CRM, sans surprise.
        </FeatureCard>
        <FeatureCard
          icon="📊"
          title="CRM sur Excel"
          palette="blue"
          href={path('crm-excel')}
          cta="Modèle gratuit"
        >
          Un modèle gratuit pour démarrer, et les limites à connaître avant de grandir.
        </FeatureCard>
      </FeatureGrid>
    </div>
  </section>

  {/* ======================== 5. CONFIANCE (EEAT) ======================== */}
  <section class="trust">
    <div class="container trust__grid">
      <div class="trust__aside">
        <div class="trust__avatar" aria-hidden="true">{DEFAULT_AUTHOR.initials}</div>
        <p class="trust__name">{DEFAULT_AUTHOR.name}</p>
        <p class="trust__role">{DEFAULT_AUTHOR.jobTitle}</p>
      </div>
      <div class="trust__body">
        <h2>Pourquoi faire confiance à nos guides ?</h2>
        <p class="trust__story">
          Derrière crm-logiciel.fr, il y a {DEFAULT_AUTHOR.name}, consultant qui a passé des années
          à déployer des CRM pour des entreprises de toutes tailles. Il a relancé ce blog avec une
          idée simple : accompagner gratuitement les entreprises vers le bon outil, sans
          contrepartie, parce que trop d'entre elles se trompent encore faute d'un conseil honnête.
        </p>
        <ul class="pillars">
          <li>
            <span class="pillars__dot" style="--c: var(--blue)" aria-hidden="true"></span>
            <div>
              <p class="pillars__title">Indépendants</p>
              <p class="pillars__text">
                Aucun éditeur ne peut acheter sa place dans nos classements.
              </p>
            </div>
          </li>
          <li>
            <span class="pillars__dot" style="--c: var(--teal)" aria-hidden="true"></span>
            <div>
              <p class="pillars__title">Testés pour de vrai</p>
              <p class="pillars__text">
                Chaque outil est utilisé, pas seulement décrit.
                <a href={path('methodologie')}>Notre méthodologie</a>.
              </p>
            </div>
          </li>
          <li>
            <span class="pillars__dot" style="--c: var(--green)" aria-hidden="true"></span>
            <div>
              <p class="pillars__title">Gratuit, sans contrepartie</p>
              <p class="pillars__text">Nos guides sont en accès libre, et le resteront.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* ======================== 6. CTA FINAL ======================== */}
  <section class="finalcta">
    <div class="container finalcta__inner">
      <h2>Prêt à trouver votre CRM ?</h2>
      <p>
        Commencez par le guide qui colle à votre situation. Le configurateur, lui, fera bientôt le
        tri pour vous.
      </p>
      <Button href={path('comment-choisir-crm')} variant="ghost">Découvrir comment choisir</Button>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===================== HERO ===================== */
  .hero {
    padding-block: clamp(var(--space-12), 8vw, var(--space-24)) var(--space-16);
    background:
      radial-gradient(55% 50% at 10% 0%, var(--blue-tint) 0%, transparent 60%),
      radial-gradient(45% 45% at 100% 5%, var(--teal-tint) 0%, transparent 55%);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: var(--space-12);
    align-items: center;
  }
  .hero__eyebrow {
    margin-bottom: var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--blue);
  }
  .hero__title {
    font-size: clamp(var(--text-4xl), 5.5vw, var(--text-6xl));
    max-width: 16ch;
  }
  .degrade {
    background: var(--grad-iris);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gradient-pan 12s ease infinite;
  }
  .hero__lead {
    margin-top: var(--space-6);
    max-width: var(--measure-narrow);
    font-size: var(--text-xl);
    color: var(--text-muted);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .hero__trust li {
    position: relative;
    padding-left: var(--space-5);
  }
  .hero__trust li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green-ink);
    font-weight: var(--font-weight-bold);
  }

  /* Visuel pipeline stylisé */
  .hv {
    padding: var(--space-5);
    border-radius: var(--radius-xl);
  }
  .hv__bar {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .hv__bar span {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: var(--radius-full);
    background: var(--border-strong);
  }
  .hv__board {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .hv__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--blue) 4%, #fff);
    border: var(--rule-hair) solid var(--border-default);
  }
  .hv__coltitle {
    font-family: var(--font-data);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
  }
  .hv__card {
    height: 1.5rem;
    border-radius: var(--radius-sm);
    background: var(--surface-sunk);
    border: var(--rule-hair) solid var(--border-default);
  }
  .hv__card--sm {
    width: 70%;
  }
  .hv__card--accent {
    background: var(--blue-tint);
    border-color: color-mix(in srgb, var(--blue) 30%, transparent);
    animation: hv-pulse 3.2s ease-in-out infinite;
  }
  .hv__card--won {
    background: var(--green-tint);
    border-color: color-mix(in srgb, var(--green) 35%, transparent);
  }
  @keyframes hv-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
    50% {
      box-shadow: var(--shadow-glow);
    }
  }

  /* ===================== BANDEAU « DE RETOUR » ===================== */
  .comeback {
    background: var(--blue-tint);
    padding-block: var(--space-5);
  }
  .comeback p {
    text-align: center;
    font-size: var(--text-lg);
    color: var(--blue-ink);
  }

  /* ===================== EN-TÊTES DE SECTION ===================== */
  .section-head {
    text-align: center;
    max-width: var(--measure-narrow);
    margin-inline: auto;
    margin-bottom: var(--space-10);
  }
  .section-head h2 {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
  }
  .section-head p {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--text-muted);
  }

  /* ===================== TIMELINE ===================== */
  .guides {
    padding-block: var(--space-20);
  }
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 64rem;
    margin-inline: auto;
  }
  /* Le fil descendant (dégradé : violet → teal → orange estompé). */
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    background: linear-gradient(
      180deg,
      var(--blue) 0%,
      var(--teal) 55%,
      color-mix(in srgb, var(--orange) 50%, transparent) 100%
    );
  }
  .tl-item {
    position: relative;
    width: 50%;
    box-sizing: border-box;
    padding-block: var(--space-4);
  }
  .tl-item:nth-child(odd) {
    left: 0;
    padding-right: var(--space-12);
  }
  .tl-item:nth-child(even) {
    left: 50%;
    padding-left: var(--space-12);
  }
  .tl-pastille {
    position: absolute;
    top: var(--space-6);
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-full);
    background: var(--grad-brand);
    color: #fff;
    font-weight: var(--font-weight-bold);
    font-size: var(--text-base);
    box-shadow: var(--shadow-glow);
    z-index: 1;
  }
  .tl-item:nth-child(odd) .tl-pastille {
    right: calc(-1.2rem);
  }
  .tl-item:nth-child(even) .tl-pastille {
    left: calc(-1.2rem);
  }
  .tl-card {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
  }
  .tl-card > * {
    position: relative;
    z-index: 1;
  }
  .tl-card__title {
    font-size: var(--text-xl);
  }
  .tl-card__text {
    margin-top: var(--space-3);
    font-size: var(--text-base);
    color: var(--text-muted);
  }
  .tl-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-sm);
    color: var(--blue-ink);
  }
  .tl-card__link span {
    transition: transform 0.18s ease;
  }
  .tl-card__link:hover span {
    transform: translateX(3px);
  }
  .tl-card .badge {
    margin-top: var(--space-4);
  }

  /* Étape finale : pleine largeur, centrée, accent. */
  .tl-item--final {
    width: 100%;
    left: 0;
    padding: var(--space-10) 0 0;
    display: flex;
    justify-content: center;
  }
  .tl-pastille--final {
    left: 50%;
    transform: translateX(-50%);
    top: 0;
    background: var(--grad-sunset);
  }
  .tl-card--final {
    max-width: 36rem;
    text-align: center;
    padding: var(--space-8);
    border: var(--rule-medium) solid color-mix(in srgb, var(--orange) 30%, transparent);
  }
  .tl-card--final .tl-card__title {
    font-size: var(--text-2xl);
    margin-top: var(--space-3);
  }
  .notify {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }
  .notify__input {
    min-height: var(--tap-min);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: var(--rule-hair) solid var(--border-strong);
    background: var(--surface-card);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    min-width: 13rem;
  }

  /* ===================== EXPLORER PAR BESOIN ===================== */
  .byneed {
    padding-block: var(--space-12) var(--space-20);
  }

  /* ===================== CONFIANCE (EEAT) ===================== */
  .trust {
    background: var(--surface-sunk);
    border-block: var(--rule-hair) solid var(--border-default);
    padding-block: var(--space-20);
  }
  .trust__grid {
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: var(--space-12);
    align-items: start;
  }
  .trust__aside {
    text-align: center;
  }
  .trust__avatar {
    display: grid;
    place-items: center;
    width: 8rem;
    height: 8rem;
    margin: 0 auto var(--space-4);
    border-radius: var(--radius-full);
    background: var(--grad-brand);
    color: #fff;
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-4xl);
    box-shadow: var(--shadow-glow);
  }
  .trust__name {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-xl);
    color: var(--ink);
  }
  .trust__role {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .trust__story {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--text-body);
    max-width: var(--measure-text);
  }
  .pillars {
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-5);
  }
  .pillars li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .pillars__dot {
    flex: none;
    margin-top: 0.35em;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: var(--radius-full);
    background: var(--c);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 18%, transparent);
  }
  .pillars__title {
    font-weight: var(--font-weight-bold);
    color: var(--ink);
  }
  .pillars__text {
    margin-top: var(--space-1);
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  /* ===================== CTA FINAL ===================== */
  .finalcta {
    padding-block: var(--space-20);
  }
  .finalcta__inner {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--space-12) var(--space-8);
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(
        80% 120% at 50% 0%,
        color-mix(in srgb, var(--blue) 18%, transparent),
        transparent 70%
      ),
      var(--surface-card);
    border: var(--rule-hair) solid var(--border-default);
    box-shadow: var(--shadow-soft);
  }
  .finalcta h2 {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
  }
  .finalcta p {
    margin: var(--space-4) auto var(--space-8);
    max-width: 40ch;
    font-size: var(--text-lg);
    color: var(--text-muted);
  }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 880px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      order: 2;
      max-width: 26rem;
    }
    .trust__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      text-align: center;
    }
    .trust__story {
      margin-inline: auto;
    }
    .pillars li {
      text-align: left;
    }
  }

  @media (max-width: 760px) {
