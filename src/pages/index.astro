---
/**
 * Accueil — version Phase 1 (squelette dans BaseLayout + JSON-LD home).
 * La home éditoriale complète (héritage 2007, timeline, EEAT) est construite
 * en Phase 2b. Laissée noindex tant que le contenu n'est pas finalisé.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../config/site';
import { organization, website, graph } from '../lib/schema';

const homeSchema = graph(organization(), website());
---

<BaseLayout
  title={SITE.longName}
  description={SITE.description}
  canonicalSlug=""
  ogType="website"
  rawTitle
  noindex
>
  <Fragment slot="head">
    <JsonLd schema={homeSchema} />
  </Fragment>

  <section class="home-hero">
    <div class="container">
      <p class="kicker is-data">Média de référence · CRM</p>
      <h1 class="home-hero__title">
        Comprendre, choisir et utiliser un <span class="degrade">CRM</span>, sans jargon.
      </h1>
      <p class="home-hero__lead">
        Domaine historique actif depuis 2007, de retour avec des guides indépendants et une base
        technique irréprochable, lisible par les humains comme par les moteurs de réponse.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding-block: clamp(var(--space-16), 10vw, var(--space-24));
    background:
      radial-gradient(60% 50% at 12% 0%, var(--blue-tint) 0%, transparent 60%),
      radial-gradient(45% 40% at 100% 0%, var(--teal-tint) 0%, transparent 55%);
  }
  .kicker {
    margin-bottom: var(--space-5);
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--blue);
  }
  .home-hero__title {
    max-width: 20ch;
    font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
  }
  .degrade {
    background: var(--grad-iris);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gradient-pan 12s ease infinite;
  }
  .home-hero__lead {
    max-width: var(--measure-narrow);
    margin-top: var(--space-6);
    font-size: var(--text-xl);
    color: var(--text-muted);
  }
</style>
