---
/**
 * Accueil — crm-logiciel.fr (Phase 2b, version enrichie).
 * Construit d'après la proposition de home N1-01 : hero « héritage 2007 / de
 * retour », bandeau de transition, timeline de guides (le cœur), grille « par
 * besoin », section de confiance EEAT, bandeau CTA final.
 *
 * Réconciliation avec l'arborescence de lancement (27 URLs) : le configurateur
 * (/quel-crm/), le comparatif, les pages CRM gratuit et CRM par secteur sont
 * DIFFÉRÉS → présentés en « prochainement » (badge, sans lien), ou remplacés par
 * des pages de lancement réelles dans la grille « par besoin ».
 *
 * Animations : CSS pur (réutilise src/styles/animations.css). Entrées du hero au
 * chargement ; reveals des sections au scroll (scroll-driven, amélioration
 * progressive). Tout le contenu reste dans le HTML source (GEO) et visible sous
 * prefers-reduced-motion.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import Button from '../components/blocks/Button.astro';
import Badge from '../components/blocks/Badge.astro';
import FeatureGrid from '../components/blocks/FeatureGrid.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import Configurateur from '../components/Configurateur.astro';
import { SITE, INDEXABLE, path, DEFAULT_AUTHOR } from '../config/site';
import { organization, website, graph } from '../lib/schema';

const homeSchema = graph(organization(), website());

// Étapes de la timeline (guides). `soon` = différé → présenté « prochainement ».
const guides = [
  {
    n: 1,
    title: "Qu'est-ce qu'un CRM ?",
    text: "Pour commencer, si vous ne savez pas exactement ce qu'est un CRM ni ce qu'il peut changer pour votre entreprise, découvrez-le dans notre guide complet.",
    href: path('qu-est-ce-qu-un-crm'),
  },
  {
    n: 2,
    title: 'Les différents types de CRM',
    text: "Tous les CRM ne se ressemblent pas. Comprenez les grandes familles d'outils pour repérer celle qui correspond à vos priorités.",
    href: path('types-de-crm'),
  },
  {
    n: 3,
    title: "Les fonctionnalités d'un CRM",
    text: "Contacts, pipeline, automatisation, reporting : passez en revue ce qu'un bon CRM doit savoir faire, pour ne payer que ce qui vous sert vraiment.",
    href: path('fonctionnalites-crm'),
  },
  {
    n: 4,
    title: 'Comment choisir son CRM',
    text: "Vous y voyez plus clair ? Place à la méthode : nos critères pour choisir l'outil adapté à votre taille, votre budget et votre métier.",
    href: path('comment-choisir-crm'),
  },
  {
    n: 5,
    title: 'Quel CRM est fait pour vous ?',
    text: 'Pas le temps de tout lire ? Notre configurateur vous pose quelques questions et vous recommande aussitôt les outils les plus adaptés à votre profil.',
    href: '#configurateur',
    cta: 'Lancer le configurateur',
  },
];
---

<BaseLayout
  title={SITE.longName}
  description={SITE.description}
  canonicalSlug=""
  ogType="website"
  rawTitle
  noindex={!INDEXABLE}
>
  <Fragment slot="head">
    <JsonLd schema={homeSchema} />
  </Fragment>

  {/* ======================== 1. HERO ======================== */}
  <section class="hero">
    <span class="hero__blob hero__blob--a" aria-hidden="true"></span>
    <span class="hero__blob hero__blob--b" aria-hidden="true"></span>

    <div class="container hero__grid">
      <div class="hero__main">
        <p class="hero__eyebrow is-data anim-fade-up">Le blog français du CRM depuis 2007</p>
        <h1 class="hero__title anim-fade-up anim-delay-1">
          crm-logiciel.fr, le blog français
          <span class="degrade gradient-animated">n°1 du CRM</span>
        </h1>
        <p class="hero__lead anim-fade-up anim-delay-2">
          Après des années de silence, la référence française du CRM est de retour. La mission n'a
          pas changé : vous aider à trouver le logiciel qu'il vous faut, gratuitement et sans parti
          pris.
        </p>
        <div class="hero__cta anim-fade-up anim-delay-3">
          <Button href="#guides" variant="primary">Trouver mon CRM</Button>
          <Button href={path('qu-est-ce-qu-un-crm')} variant="ghost">Comprendre le CRM</Button>
        </div>
        <ul class="hero__trust anim-fade-up anim-delay-4">
          <li>Tests indépendants</li>
          <li>Sans publicité déguisée</li>
          <li>Mis à jour en continu</li>
        </ul>
      </div>

      {/* Visuel : pipeline CRM stylisé, animé (décoratif). */}
      <div class="hero__visual anim-fade-up anim-delay-2" aria-hidden="true">
        <div class="hv anim-float">
          <span class="hv__sheen"></span>
          <div class="hv__bar">
            <span></span><span></span><span></span>
            <em class="hv__bar-label is-data">Pipeline</em>
          </div>
          <div class="hv__board">
            <div class="hv__col">
              <span class="hv__coltitle">Contact</span>
              <span class="hv__card"></span>
              <span class="hv__card hv__card--sm"></span>
            </div>
            <div class="hv__col">
              <span class="hv__coltitle">Proposition</span>
              <span class="hv__card hv__card--accent">
                <span class="hv__fill"></span>
              </span>
              <span class="hv__card"></span>
            </div>
            <div class="hv__col">
              <span class="hv__coltitle">Signé</span>
              <span class="hv__card hv__card--won">
                <span class="hv__check">✓</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ======================== 2. BANDEAU « DE RETOUR » ======================== */}
  <section class="comeback">
    <span class="comeback__sheen" aria-hidden="true"></span>
    <div class="container">
      <p>
        Pionnier du CRM en ligne depuis 2007, <strong>crm-logiciel.fr</strong> revient avec une ambition
        intacte : redevenir le guide de référence pour choisir son outil.
      </p>
    </div>
  </section>

  {/* ============ BANDEAU SPÉCIAL : LES MEILLEURS CRM GRATUITS ============ */}
  <section class="freebanner" data-reveal>
    <div class="container freebanner__inner">
      <span class="freebanner__badge is-data" aria-hidden="true">0 €</span>
      <div class="freebanner__text">
        <p class="freebanner__kicker">Notre dossier</p>
        <p class="freebanner__title">Les meilleurs CRM gratuits en 2026</p>
        <p class="freebanner__sub">
          Dix plans gratuits passés au crible : ce qui est vraiment offert, les plafonds cachés, et
          pour quel profil le gratuit suffit durablement.
        </p>
      </div>
      <a class="freebanner__cta" href={path('crm-gratuit')}>
        Voir la sélection <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {/* ======================== 3. TIMELINE DES GUIDES ======================== */}
  <section id="guides" class="guides">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="section-kicker is-data">Le parcours</p>
        <h2>Trouvez le CRM qu'il vous faut, étape par étape</h2>
        <p class="section-sub">
          Pas besoin d'être expert. Suivez le parcours : chaque guide vous rapproche du bon choix,
          dans le bon ordre.
        </p>
      </header>

      <ol class="timeline">
        {
          guides.map((g) => (
            <li class="tl-item" data-reveal>
              <span class="tl-pastille is-data">{g.n}</span>
              <div class="tl-card glass">
                <h3 class="tl-card__title">{g.title}</h3>
                <p class="tl-card__text">{g.text}</p>
                {g.href ? (
                  <a class="tl-card__link" href={g.href}>
                    {g.cta ?? 'Lire le guide'} <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  <Badge tone="accent">Prochainement</Badge>
                )}
              </div>
            </li>
          ))
        }

        {/* Étape finale : le comparatif (différé). */}
        <li class="tl-item tl-item--final" data-reveal>
          <span class="tl-pastille tl-pastille--final anim-pulse" aria-hidden="true">★</span>
          <div class="tl-card tl-card--final glass">
            <Badge tone="accent" pop>Prochainement</Badge>
            <h3 class="tl-card__title">Notre comparatif des meilleurs CRM pour 2027</h3>
            <p class="tl-card__text">
              L'aboutissement de votre recherche : le classement complet des meilleurs CRM, testés
              un par un. En préparation, disponible très bientôt.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {/* ======================== CONFIGURATEUR (repris) ======================== */}
  <section id="configurateur" class="home-cfg">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="section-kicker is-data">Le raccourci</p>
        <h2>Trouvez votre CRM en 2 minutes</h2>
        <p class="section-sub">
          Pas le temps de tout lire ? Répondez à quelques questions : le configurateur applique la
          grille de choix pour vous et recommande les outils les plus adaptés à votre profil.
        </p>
      </header>
      <Configurateur />
    </div>
  </section>

  {/* ======================== 4. EXPLORER PAR BESOIN ======================== */}
  <section class="byneed">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="section-kicker is-data">Accès direct</p>
        <h2>Ou explorez selon votre besoin</h2>
      </header>
      <div data-reveal>
        <FeatureGrid cols={3}>
          <FeatureCard
            icon="🚀"
            title="Mettre en place un CRM"
            palette="orange"
            href={path('mise-en-place-crm')}
            cta="Voir la méthode"
          >
            La méthode pour réussir le déploiement et l'adoption par l'équipe.
          </FeatureCard>
          <FeatureCard
            icon="💶"
            title="Combien coûte un CRM"
            palette="teal"
            href={path('prix-crm')}
            cta="Décoder les prix"
          >
            Paliers, options, coûts cachés : le vrai budget d'un CRM, sans surprise.
          </FeatureCard>
          <FeatureCard
            icon="📊"
            title="CRM sur Excel"
            palette="blue"
            href={path('crm-excel')}
            cta="Modèle gratuit"
          >
            Un modèle gratuit pour démarrer, et les limites à connaître avant de grandir.
          </FeatureCard>
        </FeatureGrid>
      </div>
    </div>
  </section>

  {/* ======================== 5. CONFIANCE (EEAT) ======================== */}
  <section class="trust">
    <span class="trust__blob" aria-hidden="true"></span>
    <div class="container trust__grid">
      <div class="trust__aside" data-reveal>
        <div class="trust__avatar-wrap">
          <span class="trust__ring" aria-hidden="true"></span>
          <div class="trust__avatar">
            <img
              src={DEFAULT_AUTHOR.photo}
              alt={`Photo de ${DEFAULT_AUTHOR.name}`}
              width="128"
              height="128"
              loading="lazy"
            />
          </div>
        </div>
        <p class="trust__name">{DEFAULT_AUTHOR.name}</p>
        <p class="trust__role">{DEFAULT_AUTHOR.jobTitle}</p>
      </div>
      <div class="trust__body" data-reveal>
        <p class="section-kicker is-data">Notre promesse</p>
        <h2>Pourquoi faire confiance à nos guides ?</h2>
        <p class="trust__story">
          Derrière crm-logiciel.fr, il y a {DEFAULT_AUTHOR.name}, consultant qui a passé des années
          à déployer des CRM pour des entreprises de toutes tailles. Il a relancé ce blog avec une
          idée simple : accompagner gratuitement les entreprises vers le bon outil, sans
          contrepartie, parce que trop d'entre elles se trompent encore faute d'un conseil honnête.
        </p>
        <ul class="pillars">
          <li>
            <span class="pillars__dot" style="--c: var(--blue)" aria-hidden="true"></span>
            <div>
              <p class="pillars__title">Indépendants</p>
              <p class="pillars__text">
                Aucun éditeur ne peut acheter sa place dans nos classements.
              </p>
            </div>
          </li>
          <li>
            <span class="pillars__dot" style="--c: var(--teal)" aria-hidden="true"></span>
            <div>
              <p class="pillars__title">Testés pour de vrai</p>
              <p class="pillars__text">
                Chaque outil est utilisé, pas seulement décrit.
                <a href={path('methodologie')}>Notre méthodologie</a>.
              </p>
            </div>
          </li>
          <li>
            <span class="pillars__dot" style="--c: var(--green)" aria-hidden="true"></span>
            <div>
              <p class="pillars__title">Gratuit, sans contrepartie</p>
              <p class="pillars__text">Nos guides sont en accès libre, et le resteront.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {/* ======================== 6. CTA FINAL ======================== */}
  <section class="finalcta">
    <div class="container finalcta__inner" data-reveal>
      <span class="finalcta__sheen" aria-hidden="true"></span>
      <h2>Prêt à trouver votre CRM ?</h2>
      <p>
        Commencez par le guide qui colle à votre situation, ou laissez le configurateur faire le tri
        pour vous en deux minutes.
      </p>
      <Button href={path('comment-choisir-crm')} variant="primary">Découvrir comment choisir</Button
      >
    </div>
  </section>
</BaseLayout>

<style>
  /* ===================== HERO ===================== */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-12), 8vw, var(--space-24)) var(--space-16);
    background:
      radial-gradient(60% 55% at 8% -5%, var(--blue-tint) 0%, transparent 60%),
      radial-gradient(48% 48% at 102% 8%, var(--teal-tint) 0%, transparent 55%),
      linear-gradient(180deg, color-mix(in srgb, var(--blue-tint) 35%, #fff) 0%, #fff 70%);
  }
  /* Halos décoratifs flottants */
  .hero__blob {
    position: absolute;
    border-radius: var(--radius-blob);
    filter: blur(60px);
    z-index: 0;
    pointer-events: none;
  }
  .hero__blob--a {
    width: 24rem;
    height: 24rem;
    top: -6rem;
    right: 6%;
    background: var(--grad-cool);
    opacity: 0.16;
    animation: float-soft 9s ease-in-out infinite;
  }
  .hero__blob--b {
    width: 18rem;
    height: 18rem;
    bottom: -5rem;
    left: 2%;
    background: var(--grad-aqua);
    opacity: 0.13;
    animation: float-soft 11s ease-in-out infinite reverse;
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: var(--space-12);
    align-items: center;
  }
  .hero__eyebrow {
    margin-bottom: var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--blue);
  }
  .hero__title {
    font-size: clamp(var(--text-4xl), 5.5vw, var(--text-6xl));
    max-width: 16ch;
  }
  .degrade {
    background: var(--grad-iris);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lead {
    margin-top: var(--space-6);
    max-width: var(--measure-narrow);
    font-size: var(--text-xl);
    color: var(--text-muted);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .hero__trust li {
    position: relative;
    padding-left: var(--space-5);
  }
  .hero__trust li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green-ink);
    font-weight: var(--font-weight-bold);
  }

  /* ---- Visuel pipeline stylisé ---- */
  .hv {
    position: relative;
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-glow), var(--glass-highlight);
  }
  .hv__sheen {
    position: absolute;
    top: 0;
    left: 0;
    width: 45%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: translateX(-120%) skewX(-18deg);
    animation: sheen 6.5s ease-in-out 1.5s infinite;
    z-index: 2;
    pointer-events: none;
  }
  .hv__bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .hv__bar span {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: var(--radius-full);
    background: var(--border-strong);
  }
  .hv__bar span:nth-child(1) {
    background: var(--minium);
    opacity: 0.6;
  }
  .hv__bar span:nth-child(2) {
    background: var(--orange);
    opacity: 0.6;
  }
  .hv__bar span:nth-child(3) {
    background: var(--green);
    opacity: 0.6;
  }
  .hv__bar-label {
    margin-left: auto;
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-faint);
    font-style: normal;
  }
  .hv__board {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .hv__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--blue) 4%, #fff);
    border: var(--rule-hair) solid var(--border-default);
  }
  .hv__coltitle {
    font-family: var(--font-data);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
  }
  .hv__card {
    position: relative;
    height: 1.6rem;
    border-radius: var(--radius-sm);
    background: var(--surface-sunk);
    border: var(--rule-hair) solid var(--border-default);
    overflow: hidden;
  }
  .hv__card--sm {
    width: 70%;
  }
  .hv__card--accent {
    background: var(--blue-tint);
    border-color: color-mix(in srgb, var(--blue) 30%, transparent);
  }
  /* Barre de remplissage animée en boucle (progression d'une affaire). */
  .hv__fill {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    background: var(--grad-brand);
    opacity: 0.85;
    animation: hv-fill 4s ease-in-out infinite;
  }
  @keyframes hv-fill {
    0% {
      transform: scaleX(0.15);
    }
    55% {
      transform: scaleX(0.85);
    }
    100% {
      transform: scaleX(0.15);
    }
  }
  .hv__card--won {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--green-tint);
    border-color: color-mix(in srgb, var(--green) 35%, transparent);
    animation: pulse-soft 3.2s ease-in-out infinite;
  }
  .hv__check {
    color: var(--green-ink);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-sm);
  }

  /* ===================== BANDEAU « DE RETOUR » ===================== */
  .comeback {
    position: relative;
    overflow: hidden;
    background: linear-gradient(90deg, var(--blue-tint), var(--teal-tint), var(--blue-tint));
    background-size: 200% 100%;
    animation: gradient-pan 16s ease infinite;
    padding-block: var(--space-5);
  }
  .comeback p {
    position: relative;
    z-index: 1;
    text-align: center;
    font-size: var(--text-lg);
    color: var(--blue-ink);
  }

  /* ===================== BANDEAU SPÉCIAL CRM GRATUITS ===================== */
  .freebanner {
    scroll-margin-top: 5rem;
    padding-block: var(--space-8);
    background:
      radial-gradient(
        60% 120% at 100% 0%,
        color-mix(in srgb, var(--teal) 55%, transparent),
        transparent 70%
      ),
      linear-gradient(120deg, var(--green-ink) 0%, var(--teal-ink) 100%);
  }
  .freebanner__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .freebanner__badge {
    flex: none;
    display: grid;
    place-items: center;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.18);
    border: var(--rule-hair) solid rgba(255, 255, 255, 0.4);
    color: #fff;
    font-family: var(--font-data);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-4xl);
    line-height: 1;
  }
  .freebanner__text {
    flex: 1;
    min-width: 0;
  }
  .freebanner__kicker {
    font-size: var(--text-2xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }
  .freebanner__title {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
    color: #fff;
  }
  .freebanner__sub {
    margin-top: var(--space-2);
    max-width: 60ch;
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.88);
  }
  .freebanner__cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    background: #fff;
    color: var(--green-ink);
    font-family: var(--font-ui);
    font-weight: var(--font-weight-bold);
    box-shadow: var(--shadow-raise);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  .freebanner__cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    color: var(--green-ink);
  }
  .freebanner__cta span {
    transition: transform 0.18s ease;
  }
  .freebanner__cta:hover span {
    transform: translateX(3px);
  }
  @media (max-width: 760px) {
    .freebanner__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }
</style>

<style>
  /* ===================== EN-TÊTES DE SECTION ===================== */
  .section-head {
